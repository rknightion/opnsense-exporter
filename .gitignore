# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
opnsense-exporter-security-findings/
# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
*opnsense-exporter-local
local.Makefile
key
secret
local.docker-compose.yml
.DS_Store

# Environment files
.env
.env.*

# IDEs
.idea/
.vscode/

/opnsense-exporter
/docgen
# Stray dev binaries from `go build ./cmd/...`
/apicapture
/apicontract

# Python (grafana dashboard/rules builders)
__pycache__/
*.pyc

# Superpowers scratch (specs/plans) + local roadmap — never committed
docs/superpowers/
/roadmap.md

# Response-shape canary captures (make capture) — scratch real-box payloads.
# Review one (it may contain host/network data) and promote it into a curated
# fixture (opnsense/testdata/health/...) to make it a permanent CI gate.
/opnsense/testdata/captures/
