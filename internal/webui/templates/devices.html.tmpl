{{define "body"}}
{{with .Data}}
<section class="page-head">
  <div>
    <h1>Devices</h1>
    <p class="sub">Connected devices merged from the ARP table and DHCPv4/DHCPv6 leases. Vendor resolved from the MAC OUI.</p>
  </div>
  <div class="head-right">
    <span class="scrape-age">{{len .Report.Devices}} devices</span>
  </div>
</section>

{{if .Error}}
<div class="callout warn"><strong>Could not load devices.</strong> {{.Error}}</div>
{{end}}

<section class="card">
  <div class="filter-bar">
    <input type="search" class="filter" placeholder="Filter devices…" data-filter-target="devices" aria-label="Filter devices">
  </div>
  <table class="grid compact" data-table="devices">
    <thead>
      <tr>
        <th>IP</th>
        <th>MAC</th>
        <th>Hostname</th>
        <th>Interface</th>
        <th>Manufacturer</th>
        <th>Source</th>
        <th>Expiry</th>
      </tr>
    </thead>
    <tbody>
    {{range .Report.Devices}}
      <tr data-name="{{.IP}} {{.MAC}} {{.Hostname}} {{.Interface}} {{.Manufacturer}} {{.Source}}">
        <td data-value="{{.IP}}" data-sort="{{.IP}}">{{.IP}}</td>
        <td data-value="{{.MAC}}">{{.MAC}}</td>
        <td data-value="{{.Hostname}}">{{if .Hostname}}{{.Hostname}}{{else}}<span style="color:var(--muted)">—</span>{{end}}</td>
        <td data-value="{{.Interface}}">{{if .Interface}}{{.Interface}}{{else}}<span style="color:var(--muted)">—</span>{{end}}</td>
        <td data-value="{{.Manufacturer}}">{{if .Manufacturer}}{{.Manufacturer}}{{else}}<span style="color:var(--muted)">unknown</span>{{end}}</td>
        <td data-value="{{.Source}}"><span class="badge">{{.Source}}</span></td>
        <td data-value="{{.Expiry}}" data-sort="{{.Expiry}}">{{if .Expiry}}{{.Expiry}}{{else}}<span style="color:var(--muted)">—</span>{{end}}</td>
      </tr>
    {{else}}
      <tr><td colspan="7" class="empty">No devices found.</td></tr>
    {{end}}
    </tbody>
  </table>
</section>
{{end}}
{{end}}
