function renderCallout(id,kind,title,body,detail){ var b=document.getElementById(id); if(!b) return; b.textContent=''; b.className=kind; b.hidden=false; b.appendChild(icon(kind==='switched-off'?INFO_PATH:WARNING_CIRCLE_PATH,14)); var copy=el('div',{'class':'callout-copy'}); copy.appendChild(el('strong',{'class':'callout-title'},title)); copy.appendChild(el('span',{'class':'callout-body'},body)); if(detail) copy.appendChild(el('span',{'class':'callout-detail'},detail)); b.appendChild(copy); }
function hideCallout(id){ var b=document.getElementById(id); if(!b) return; b.hidden=true; b.textContent=''; }
function setStale(on){ var b=document.getElementById('staleBanner'); if(!b) return; if(on){ b.className='show'; b.textContent=''; b.appendChild(icon(WARNING_PATH,14)); b.appendChild(el('span',null,'Disconnected  -  last successful update '+relMs(lastOkMs))); } else { b.className=''; b.textContent=''; } }

// ── Devices (lazy) ─────────────────────────────────────────────────────────
function loadDevices(){
  var tb=document.getElementById('devBody'); if(!tb) return;
  tb.textContent=''; tb.appendChild(el('tr')).appendChild(el('td',{'colspan':'7','class':'empty'},'Loading…'));
  fetch('/api/devices.json',{cache:'no-store'}).then(function(r){ if(!r.ok) throw new Error('status '+r.status); return r.json(); }).then(function(v){
    devicesLoaded=true;
    var rows=(v.Report && v.Report.Devices)||[];
    if(v.Error){
      setText('devMatch','0 of 0'); setText('devCacheAge','cached -');
      renderCallout('devError','failure-callout','Could not load devices','This tab is the only console route that reaches the firewall, and this failure does not affect metric collection.',v.Error);
      tb.textContent=''; tb.appendChild(el('tr')).appendChild(el('td',{'colspan':'7','class':'empty'},'No device data available.')); return;
    }
    hideCallout('devError');
    var generated=v.Report && v.Report.Generated ? Date.parse(v.Report.Generated) : NaN;
    setText('devMatch',rows.length+' of '+rows.length); setText('devCacheAge',generated>0&&!isNaN(generated)?'cached '+relMs(generated):'cached just now');
    tb.textContent='';
    if(!rows.length){ tb.appendChild(el('tr')).appendChild(el('td',{'colspan':'7','class':'empty'},'No devices found.')); return; }
    rows.forEach(function(dv){ var tr=el('tr'); tr.appendChild(el('td',{'class':'mono'},dv.IP||'-')); tr.appendChild(el('td',{'class':'mono'},dv.MAC||'-')); tr.appendChild(el('td',{'class':'mono'},dv.Hostname||'-')); tr.appendChild(el('td',{'class':'dev-prose'},dv.Interface||'-')); tr.appendChild(el('td',{'class':'dev-prose'+(dv.Manufacturer?'':' muted')},dv.Manufacturer||'unknown')); var sTd=el('td'); sTd.appendChild(el('span',{'class':'badge source-chip'},dv.Source||'-')); tr.appendChild(sTd); tr.appendChild(el('td',{'class':'mono'},dv.Expiry||'-')); tb.appendChild(tr); });
  }).catch(function(e){ devicesLoaded=false; setText('devMatch','- of -'); setText('devCacheAge','cached -'); renderCallout('devError','failure-callout','Could not load devices','This tab is the only console route that reaches the firewall, and this failure does not affect metric collection.',e.message); tb.textContent=''; tb.appendChild(el('tr')).appendChild(el('td',{'colspan':'7','class':'empty'},'No device data available.')); });
}

// ── ifIndex map (lazy) ─────────────────────────────────────────────────────
// The endpoint 404s when the NetFlow flow lane is off. That is a statement about
// configuration, not a failure, so it gets its own message - "failed to load"
// would send an operator hunting a fault that isn't there.
function ifxEmpty(msg){ var tb=document.getElementById('ifxBody'); if(!tb) return; tb.textContent=''; tb.appendChild(el('tr')).appendChild(el('td',{'colspan':'6','class':'empty'},msg)); }
function loadIfIndex(){
  var tb=document.getElementById('ifxBody'); if(!tb) return;
  ifxEmpty('Loading…');
  fetch('/api/ifindex.json',{cache:'no-store'}).then(function(r){
    if(r.status===404){ ifIndexLoaded=true; return null; }
    if(!r.ok) throw new Error('status '+r.status);
    return r.json();
  }).then(function(v){
    var err=document.getElementById('ifxError');
    if(v===null){ ifIndexLoaded=true; setTabCount('ifxTabCount',0); renderCallout('ifxError','switched-off','NetFlow is not enabled','There is no ifIndex map to resolve. This is a configuration state, not a failure.'); ifxEmpty('NetFlow is not enabled, so there is no ifIndex map to resolve.'); return; }
    ifIndexLoaded=true;
    setText('ifxEntries', v.Entries); setText('ifxOverridden', v.Overridden);
    setText('ifxConflicts', v.Conflicts); setText('ifxDisagreements', v.Disagreements);
    setText('ifxUnmapped', v.Unmapped);
    var b=v.Built?new Date(v.Built):null; setText('ifxBuilt', (b && !isNaN(b))?b.toLocaleTimeString():'-');
    setTabCount('ifxTabCount',Number(v.Disagreements)||0);
    if(v.Disagreements>0){ renderCallout('ifxError','failure-callout','Interface index disagreement',v.Disagreements+' interface(s) resolve to an index the firewall states differently. Check the marked rows against ifinfo before trusting any per-interface flow series.'); } else { hideCallout('ifxError'); }
    var rows=v.Rows||[];
    tb.textContent='';
    if(!rows.length){ ifxEmpty('No ifIndex entries resolved yet.'); return; }
    rows.forEach(function(x){
      var tr=el('tr');
      if(x.Disagrees) tr.className='t2o-row--alert ifx-disagrees';
      else if(x.Source==='override') tr.className='t2o-row--note ifx-override';
      tr.appendChild(el('td',{'class':'num'},String(x.Index)));
      tr.appendChild(el('td',{'class':'mono'},x.Device||'-'));
      tr.appendChild(el('td',{'class':'dev-prose'},x.Name||'-'));
      var sTd=el('td'), source=el('span',{'class':'badge source-chip source-'+(x.Source==='override'?'override':'derived')}); if(x.Source==='override') source.appendChild(icon(PENCIL_PATH,11)); source.appendChild(document.createTextNode(x.Source||'-')); sTd.appendChild(source); tr.appendChild(sTd);
      tr.appendChild(el('td',{'class':'num'+(x.Disagrees?' ifx-state-disagree':'' )}, x.Stated?String(x.Stated):'-'));
      var nTd=el('td'); if(x.Disagrees){ nTd.appendChild(el('span',{'class':'badge badge-bad'},'disagrees')); } else { nTd.appendChild(el('span',{'class':'muted'},'-')); } tr.appendChild(nTd);
      tb.appendChild(tr);
    });
  }).catch(function(e){ ifIndexLoaded=false; renderCallout('ifxError','failure-callout','Could not load ifIndex map','The resolved map is unavailable, so per-interface flow labels may be unreliable until this reload succeeds.',e.message); ifxEmpty('No ifIndex data available.'); });
}

// ── Poll + patch ──────────────────────────────────────────────────────────
function refresh(){
  fetch('/api/status.json',{cache:'no-store'}).then(function(r){ if(!r.ok) throw new Error('status '+r.status); return r.json(); }).then(function(d){
    lastData=d; lastOkMs=Date.now(); setStale(false);
    setHealth(d); updateRollup(d); updateOverview(d); updateTrend(d);
    rebuildCollectors(d.Collectors); rebuildAPI(d.API); rebuildCardinality(d.Cardinality); rebuildPipeline(d.Pipeline);
    if(d.Generated){ var g=new Date(d.Generated); if(!isNaN(g)) setText('generatedAt', g.toLocaleTimeString()); }
    redrawCharts();
  }).catch(function(){ setStale(true); });
}
function startPolling(){ if(pollTimer) clearInterval(pollTimer); var ms=(window.__refreshMs>0?window.__refreshMs:5000); pollTimer=setInterval(refresh,ms); }
function togglePause(){ paused=!paused; var btn=document.getElementById('pauseBtn'); if(paused){ if(pollTimer){clearInterval(pollTimer); pollTimer=null;} if(btn) btn.textContent='Resume'; } else { if(btn) btn.textContent='Pause'; refresh(); startPolling(); } }
function tickFreshness(){ setText('updatedAgo', relMs(lastOkMs)); var b=document.getElementById('staleBanner'); if(b && b.className.indexOf('show')>=0) setStale(true); }

(function init(){
  registerChart('chGoroutines', function(d){ return d&&d.Runtime ? [{name:'goroutines', points:d.Runtime.GoroutinesSeries||[]}] : []; });
  registerChart('chHeap', function(d){ return d&&d.Runtime ? [{name:'heap', points:(d.Runtime.HeapAllocSeries||[]).map(function(b){return b/1048576;})}] : []; }, function(v){ return v.toFixed(0)+'M'; });
  registerChart('chGC', function(d){ return d&&d.Runtime ? [{name:'gc/s', color:cssVar('--warn'), points:d.Runtime.GCRateSeries||[]}] : []; }, function(v){ return v.toFixed(1); });
  registerChart('chCard', function(d){ return d&&d.Trend ? [{name:'series', points:d.Trend.SeriesCountSeries||[]}] : []; });
  // Emitted throughput on a PULL exporter is the log-shipping pipeline's OTLP push
  // path  -  the only stream of records this process actually emits. With log shipping
  // off there is nothing to chart, so draw nothing rather than a fabricated flat line.
  registerChart('chEmit', function(d){ if(!d||!d.Trend||!d.Trend.LogShipping) return []; return [{name:'shipped/s', points:d.Trend.ShippedRateSeries||[]},{name:'dropped/s', color:cssVar('--err'), points:d.Trend.DroppedRateSeries||[]}]; }, function(v){ return v.toFixed(2); });
  registerChart('chFailing', function(d){ return d&&d.Trend ? [{name:'failing', color:cssVar('--err'), points:d.Trend.FailingSeries||[]}] : []; });
  registerChart('chDuration', function(d){ return d&&d.Trend ? [{name:'mean', points:d.Trend.MeanDurationMsSeries||[]}] : []; }, function(v){ return v.toFixed(0)+'ms'; });
  initTabs();
  var tt=document.getElementById('themeToggle'); if(tt) tt.addEventListener('click',toggleTheme);
  var p=document.getElementById('pauseBtn'); if(p) p.addEventListener('click',togglePause);
  var rn=document.getElementById('refreshNow'); if(rn) rn.addEventListener('click',function(ev){ ev.preventDefault(); refresh(); });
  var dr=document.getElementById('devReload'); if(dr) dr.addEventListener('click',function(ev){ ev.preventDefault(); devicesLoaded=false; loadDevices(); });
  var ir=document.getElementById('ifxReload'); if(ir) ir.addEventListener('click',function(ev){ ev.preventDefault(); ifIndexLoaded=false; loadIfIndex(); });
  window.addEventListener('resize', redrawCharts);
  refresh(); startPolling(); setInterval(tickFreshness,1000);
})();
</script>
