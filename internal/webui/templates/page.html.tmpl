<style>
/* ─────────────────────────────────────────────────────────────────────────────
   m7kni Design System v2 - 2otel console family token block.
   SHARED VERBATIM across tailscale2otel, opnsense2otel, graph2otel,
   codexlb2otel. Do not edit in one repo only. Generated from
   packages/tokens (DTCG) - hex values are the resolved sRGB of the oklch
   sources noted per line.
   ───────────────────────────────────────────────────────────────────────── */
:root{
  /* Type */
  --t2o-sans:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --t2o-mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --t2o-fs-2xs:10px;   /* uppercase micro labels */
  --t2o-fs-xs:11px;    /* mono sub-values, notes, badges */
  --t2o-fs-sm:12.5px;  /* table cells, controls, machine text */
  --t2o-fs-md:13.5px;  /* body copy */
  --t2o-fs-lg:15px;    /* page title, card values */
  --t2o-fs-xl:18px;    /* posture values */
  --t2o-fs-2xl:24px;   /* rare, one per page at most */
  --t2o-fw-regular:400;
  --t2o-fw-medium:500;
  --t2o-fw-semibold:600;
  --t2o-tracking-label:0.13em;

  /* Space and shape */
  --t2o-space-1:4px;  --t2o-space-2:8px;  --t2o-space-3:12px;
  --t2o-space-4:16px; --t2o-space-5:20px; --t2o-space-6:24px;
  --t2o-radius-control:3px;    /* buttons, inputs, chips, badges */
  --t2o-radius-container:0px;  /* panels, cards, tables - square */
  --t2o-radius-overlay:6px;    /* tooltips, popovers */
  --t2o-row:36px;              /* table row height */
  --t2o-dur-fast:120ms; --t2o-dur-base:160ms;

  /* Light theme - the default */
  --t2o-bg:#eef3f6;            /* oklch(0.962 0.007 227) */
  --t2o-surface:#f6fafb;       /* oklch(0.982 0.004 227) */
  --t2o-raised:#ffffff;        /* oklch(1 0 0) - table headers, inputs */
  --t2o-hover:#e7eef1;         /* oklch(0.945 0.009 227) */
  --t2o-selected:#dee8ec;      /* oklch(0.925 0.012 227) */
  --t2o-track:#c7cfd3;         /* oklch(0.85 0.01 227) - bar troughs */
  --t2o-fg:#192124;            /* oklch(0.24 0.012 227) */
  --t2o-fg-soft:#384146;       /* oklch(0.37 0.015 227) */
  --t2o-fg-muted:#59666b;      /* oklch(0.5 0.018 227) */
  --t2o-fg-faint:#869196;      /* oklch(0.65 0.015 227) - placeholder/disabled ONLY */
  --t2o-accent:#1d6a8a;        /* petrol */
  --t2o-accent-hover:#175874;
  --t2o-accent-soft:#e4eef4;   /* banner and selected-row wash */
  --t2o-on-accent:#ffffff;
  --t2o-line:#d9dfe2;          /* oklch(0.9 0.008 227) */
  --t2o-line-strong:#bec5c9;   /* oklch(0.82 0.01 227) */
  --t2o-ok:#2f7d4f;
  --t2o-warn:#8f6410;
  --t2o-fail:#a83a2e;

  /* Direction pair - see section 7 */
  --t2o-tx:var(--t2o-accent);
  --t2o-rx:var(--t2o-fg);
}

/* No stored preference: follow the OS. Explicit data-theme always wins. */
@media (prefers-color-scheme: dark){
  :root:not([data-theme]){
    --t2o-bg:#101618; --t2o-surface:#161d20; --t2o-raised:#1e2529;
    --t2o-hover:#1b2225; --t2o-selected:#222a2e; --t2o-track:#373f42;
    --t2o-fg:#e1e5e8; --t2o-fg-soft:#b7bfc3; --t2o-fg-muted:#95a1a6; --t2o-fg-faint:#697478;
    --t2o-accent:#66aecb; --t2o-accent-hover:#7cbcd6; --t2o-accent-soft:#1f2f38;
    --t2o-on-accent:#0e161b;
    --t2o-line:#2a3235; --t2o-line-strong:#40494e;
    --t2o-ok:#5fae7f; --t2o-warn:#c9a04a; --t2o-fail:#d97b64;
  }
}
:root[data-theme="light"]{
  --t2o-bg:#eef3f6; --t2o-surface:#f6fafb; --t2o-raised:#ffffff;
  --t2o-hover:#e7eef1; --t2o-selected:#dee8ec; --t2o-track:#c7cfd3;
  --t2o-fg:#192124; --t2o-fg-soft:#384146; --t2o-fg-muted:#59666b; --t2o-fg-faint:#869196;
  --t2o-accent:#1d6a8a; --t2o-accent-hover:#175874; --t2o-accent-soft:#e4eef4;
  --t2o-on-accent:#ffffff;
  --t2o-line:#d9dfe2; --t2o-line-strong:#bec5c9;
  --t2o-ok:#2f7d4f; --t2o-warn:#8f6410; --t2o-fail:#a83a2e;
}
:root[data-theme="dark"]{
  --t2o-bg:#101618; --t2o-surface:#161d20; --t2o-raised:#1e2529;
  --t2o-hover:#1b2225; --t2o-selected:#222a2e; --t2o-track:#373f42;
  --t2o-fg:#e1e5e8; --t2o-fg-soft:#b7bfc3; --t2o-fg-muted:#95a1a6; --t2o-fg-faint:#697478;
  --t2o-accent:#66aecb; --t2o-accent-hover:#7cbcd6; --t2o-accent-soft:#1f2f38;
  --t2o-on-accent:#0e161b;
  --t2o-line:#2a3235; --t2o-line-strong:#40494e;
  --t2o-ok:#5fae7f; --t2o-warn:#c9a04a; --t2o-fail:#d97b64;
}

/* ── Compatibility aliases ───────────────────────────────────────────────────
   The three templates already reference --bg/--panel/--line/... in hundreds of
   places, including inside JS that writes `fill:"var(--rx)"` into SVG. Keeping
   these aliases means the restyle lands as a palette swap plus targeted
   per-page edits, not a rename sweep. New CSS should use the --t2o-* names.
   ───────────────────────────────────────────────────────────────────────── */
:root{
  --bg:var(--t2o-bg);
  --panel:var(--t2o-surface);
  --panel2:var(--t2o-raised);
  --line:var(--t2o-line);
  --fg:var(--t2o-fg);
  --muted:var(--t2o-fg-muted);
  --accent:var(--t2o-accent);
  --ok:var(--t2o-ok);
  --warn:var(--t2o-warn);
  --err:var(--t2o-fail);
  --pending:var(--t2o-fg-muted);
  --grid:var(--t2o-line);
  --tx:var(--t2o-tx);
  --rx:var(--t2o-rx);
  --mono:var(--t2o-mono);
}
@font-face{
  font-family:"Hanken Grotesk"; font-style:normal; font-weight:100 900; font-display:swap;
  src:url("/_static/fonts/hanken-grotesk-latin.woff2") format("woff2");
  unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face{
  font-family:"Hanken Grotesk"; font-style:normal; font-weight:100 900; font-display:swap;
  src:url("/_static/fonts/hanken-grotesk-latin-ext.woff2") format("woff2");
  unicode-range:U+0100-024F,U+0259,U+1E00-1EFF,U+2020,U+20A0-20AB,U+20AD-20CF,U+2113,U+2C60-2C7F,U+A720-A7FF;
}
@font-face{
  font-family:"JetBrains Mono"; font-style:normal; font-weight:100 800; font-display:swap;
  src:url("/_static/fonts/JetBrainsMono-Variable.woff2") format("woff2");
}
:root{
  --t2o-chart-grid:var(--t2o-line);
  --t2o-chart-axis:var(--t2o-fg-muted);
  --t2o-series-1:var(--t2o-accent);
  --t2o-series-2:var(--t2o-fg);
  --t2o-series-3:var(--t2o-warn);
  --t2o-chart-area:0.10;
  --t2o-chart-h:110px;
  --t2o-chart-h-tall:150px;
  --t2o-spark-w:100px;
  --t2o-spark-h:22px;
  --t2o-row-marker:2px;
}
:root[data-theme="light"]{color-scheme:light}
:root[data-theme="dark"]{color-scheme:dark}
@media (prefers-color-scheme: dark){
  :root:not([data-theme]){color-scheme:dark}
}
*{box-sizing:border-box}
body{margin:0;background:var(--t2o-bg);color:var(--t2o-fg-soft);font:var(--t2o-fs-md)/1.5 var(--t2o-sans)}
a{color:var(--t2o-accent);text-decoration:none}
a:hover{text-decoration:underline}
code{font-family:var(--t2o-mono);font-size:var(--t2o-fs-sm);background:var(--t2o-raised);padding:1px 5px;border-radius:var(--t2o-radius-control)}
header{padding:12px 20px;background:var(--t2o-surface);border-bottom:1px solid var(--t2o-line);display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
header h1{margin:0;font:var(--t2o-fw-semibold) var(--t2o-fs-lg)/1.2 var(--t2o-sans);color:var(--t2o-fg)}
header .ver{font:var(--t2o-fs-xs)/1.3 var(--t2o-mono);color:var(--t2o-fg-muted)}
header .spacer{flex:1}
main{max-width:1320px;margin:0 auto;padding:18px 24px 60px}
section{margin:0 0 26px}
section>h2,.sub-h{font:var(--t2o-fw-semibold) var(--t2o-fs-2xs)/1.2 var(--t2o-sans);letter-spacing:var(--t2o-tracking-label);text-transform:uppercase;color:var(--t2o-fg-muted);margin:26px 0 12px}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.card{background:var(--t2o-surface);border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container);padding:10px 12px}
.card .k{font:var(--t2o-fw-semibold) var(--t2o-fs-2xs)/1.2 var(--t2o-sans);letter-spacing:var(--t2o-tracking-label);text-transform:uppercase;color:var(--t2o-fg-muted);margin-bottom:6px}
.card .v{font:var(--t2o-fw-medium) var(--t2o-fs-lg)/1.2 var(--t2o-mono);font-variant-numeric:tabular-nums;color:var(--t2o-fg)}
.card .sub{font:var(--t2o-fs-xs)/1.4 var(--t2o-mono);color:var(--t2o-fg-muted);margin-top:4px;overflow-wrap:anywhere}
.card.crit{border-color:var(--t2o-fail)}
.card.warn2{border-color:var(--t2o-warn)}
table,.t2o-table{width:100%;border-collapse:collapse;background:var(--t2o-surface);border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container);overflow:hidden}
.t2o-table{width:100%;border-collapse:collapse;background:var(--t2o-surface);border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container)}
.t2o-table th{position:sticky;top:0;z-index:1;background:var(--t2o-raised);border-bottom:1px solid var(--t2o-line-strong);padding:7px 12px;text-align:left;font-family:var(--t2o-sans);font-size:var(--t2o-fs-2xs);font-weight:600;letter-spacing:var(--t2o-tracking-label);text-transform:uppercase;color:var(--t2o-fg-muted);white-space:nowrap}
.t2o-table td{padding:8px 12px;height:var(--t2o-row);vertical-align:top;border-bottom:1px solid var(--t2o-line);font-family:var(--t2o-mono);font-size:var(--t2o-fs-sm);font-variant-numeric:tabular-nums}
.t2o-table tbody tr:last-child td{border-bottom:0}
.t2o-table tbody tr:hover{background:var(--t2o-raised)}
.t2o-table td.num{text-align:right;white-space:nowrap}
.t2o-table td .sub{display:block;font-size:var(--t2o-fs-xs);color:var(--t2o-fg-muted);margin-top:1px}
table th,table td{padding:8px 12px;border-bottom:1px solid var(--t2o-line);vertical-align:top;font-variant-numeric:tabular-nums}
table th{position:sticky;top:0;z-index:1;background:var(--t2o-raised);border-bottom-color:var(--t2o-line-strong);font:var(--t2o-fw-semibold) var(--t2o-fs-2xs)/1.2 var(--t2o-sans);letter-spacing:var(--t2o-tracking-label);text-transform:uppercase;color:var(--t2o-fg-muted);white-space:nowrap}
table td{height:var(--t2o-row);font:var(--t2o-fs-sm)/1.4 var(--t2o-mono)}
table tbody tr:last-child td{border-bottom:0}
table tbody tr:hover{background:var(--t2o-raised)}
table td.num{text-align:right;white-space:nowrap}
table td .sub{display:block;font-size:var(--t2o-fs-xs);color:var(--t2o-fg-muted);margin-top:1px}
.t2o-row--alert{box-shadow:inset var(--t2o-row-marker) 0 0 var(--t2o-fail)}
.t2o-row--note{box-shadow:inset var(--t2o-row-marker) 0 0 var(--t2o-accent)}
tr.bad>td,tr.ifx-disagrees>td,tr.ifx-override>td{background:transparent}
tr.bad,.t2o-row--alert{box-shadow:inset var(--t2o-row-marker) 0 0 var(--t2o-fail)}
tr.ifx-override,.t2o-row--note{box-shadow:inset var(--t2o-row-marker) 0 0 var(--t2o-accent)}
tr.err-row td{color:var(--t2o-fail)}
.mono,code{font-family:var(--t2o-mono);overflow-wrap:anywhere}
.muted{color:var(--t2o-fg-muted)}
.empty{color:var(--t2o-fg-muted);text-align:center;padding:16px}
.note{color:var(--t2o-fg-soft);font-size:var(--t2o-fs-sm);line-height:1.65;max-width:940px}
.badge{display:inline-flex;align-items:center;gap:5px;padding:1px 6px;border:1px solid currentColor;border-radius:var(--t2o-radius-control);background:transparent!important;color:var(--t2o-fg-muted);font:var(--t2o-fw-semibold) var(--t2o-fs-xs)/1.4 var(--t2o-sans);letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}
.badge-ok,.badge.ok{color:var(--t2o-ok)}
.badge-bad,.badge.bad,.badge.err,.badge.critical,.badge.degraded{color:var(--t2o-fail)}
.badge-warn,.badge.warn,.badge.warning{color:var(--t2o-warn)}
.badge-pending,.badge.pending,.badge.none{color:var(--t2o-fg-muted)}
.badge-neutral{color:var(--t2o-fg-muted)}
.badge-ok::before,.badge.ok::before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor;flex:0 0 auto}
.badge-bad::before,.badge.bad::before,.badge.err::before,.badge.critical::before,.badge.degraded::before{content:"";width:8px;height:8px;background:currentColor;transform:rotate(45deg);flex:0 0 auto}
.badge-warn::before,.badge.warn::before,.badge.warning::before{content:"";width:9px;height:8px;background:currentColor;clip-path:polygon(50% 0,100% 100%,0 100%);flex:0 0 auto}
.badge-pending::before,.badge.pending::before,.badge.none::before{content:"";width:8px;height:8px;border:1.5px solid currentColor;border-radius:50%;background:transparent;flex:0 0 auto}
.badge-pending::before,.badge.pending::before{border-style:dashed}
.badge-neutral::before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor;flex:0 0 auto}
.badge.source-chip::before{display:none}
.dot{display:inline-flex;align-items:center;gap:5px;margin-right:2px;color:var(--t2o-fg-soft);font:var(--t2o-fs-sm)/1.4 var(--t2o-mono)}
.dot::before{content:"";width:8px;height:8px;display:inline-block;flex:0 0 auto;background:currentColor}
.dot-ok::before{border-radius:50%;color:var(--t2o-ok)}
.dot-bad::before{color:var(--t2o-fail);transform:rotate(45deg)}
.dot-warn::before{color:var(--t2o-warn);clip-path:polygon(50% 0,100% 100%,0 100%)}
svg.spark{width:var(--t2o-spark-w);height:var(--t2o-spark-h);vertical-align:middle;display:inline-block}
svg.spark polyline{fill:none;stroke:var(--t2o-series-1);stroke-width:1.5;vector-effect:non-scaling-stroke}
.outcomes{display:inline-flex;gap:2px;align-items:center}
.outcomes .cell{width:5px;height:14px;background:var(--t2o-ok);display:inline-block}
.outcomes .cell.bad{background:var(--t2o-fail)}
.filter{width:100%;max-width:340px;margin-bottom:10px;padding:7px 11px;background:var(--t2o-raised);border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-control);color:var(--t2o-fg);font:var(--t2o-fs-sm)/1.3 var(--t2o-sans)}
.filter::placeholder{color:var(--t2o-fg-faint)}
.filter:focus,button.ctl:focus,button.tab-btn:focus{outline:2px solid var(--t2o-accent);outline-offset:2px}
.scroll{max-height:460px;overflow:auto;border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container)}
.scroll.tall{max-height:75vh}
.scroll table{border:0;border-radius:0}
.rollup{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0;padding:0;background:var(--t2o-surface);border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container);margin-bottom:18px}
.rollup .rc{padding:10px 12px;border-right:1px solid var(--t2o-line);display:flex;flex-direction:column}
.rollup .rc:last-child{border-right:0}
.rollup .rc .rv{font:var(--t2o-fw-medium) var(--t2o-fs-xl)/1.2 var(--t2o-mono);font-variant-numeric:tabular-nums;color:var(--t2o-fg)}
.rollup .rc .rk{font:var(--t2o-fw-semibold) var(--t2o-fs-2xs)/1.2 var(--t2o-sans);letter-spacing:var(--t2o-tracking-label);text-transform:uppercase;color:var(--t2o-fg-muted)}
.reasons{display:flex;align-items:center;gap:8px;padding:7px 20px;background:var(--t2o-accent-soft);color:var(--t2o-fg-soft);font:var(--t2o-fs-xs)/1.4 var(--t2o-mono);border-bottom:1px solid var(--t2o-line)}
.reasons svg{color:var(--t2o-fail);flex:0 0 auto}
#staleBanner{display:none;padding:8px 20px;background:var(--t2o-surface);color:var(--t2o-fg-soft);font:var(--t2o-fs-sm)/1.4 var(--t2o-sans);border-bottom:1px solid var(--t2o-line)}
#staleBanner.show{display:block}
#staleBanner svg{color:var(--t2o-warn);vertical-align:-2px;margin-right:6px}
#scrapeAge.capture-warn{color:var(--t2o-warn)}
.chart{width:100%;height:var(--t2o-chart-h);display:block}
.chart-wrap{position:relative}
.chart-tip{position:absolute;display:none;pointer-events:none;background:var(--t2o-raised);border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-overlay);padding:5px 8px;font:var(--t2o-fs-xs)/1.3 var(--t2o-mono);white-space:nowrap;z-index:6;box-shadow:0 4px 12px rgba(0,0,0,.3)}
.controls{display:inline-flex;gap:10px;align-items:center}
button.ctl{min-width:26px;min-height:26px;background:var(--t2o-raised);color:var(--t2o-fg);border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-control);padding:4px 10px;font:var(--t2o-fs-sm)/1.3 var(--t2o-sans);cursor:pointer}
button.ctl:hover{background:var(--t2o-hover);border-color:var(--t2o-accent)}
a.ctl{display:inline-flex;align-items:center;gap:5px;min-height:26px;background:var(--t2o-raised);color:var(--t2o-fg);border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-control);padding:4px 10px;font:var(--t2o-fs-sm)/1.3 var(--t2o-sans);cursor:pointer}
a.ctl:hover{background:var(--t2o-hover);border-color:var(--t2o-accent);text-decoration:none}
#themeToggle{width:26px;padding:3px}
button.ctl:disabled{color:var(--t2o-fg-faint);cursor:not-allowed}
footer{max-width:1320px;margin:0 auto;padding:0 24px 40px;color:var(--t2o-fg-muted);font:var(--t2o-fs-xs)/1.4 var(--t2o-mono)}
nav.tabs{position:sticky;top:0;z-index:5;display:flex;gap:0;flex-wrap:wrap;padding:0 20px;background:var(--t2o-surface);border-bottom:1px solid var(--t2o-line)}
.tab-btn{background:transparent;color:var(--t2o-fg-muted);border:0;border-bottom:2px solid transparent;border-radius:0;padding:9px 12px;font:var(--t2o-fw-medium) var(--t2o-fs-sm)/1.3 var(--t2o-sans);cursor:pointer}
.tab-btn:hover{background:var(--t2o-hover);color:var(--t2o-fg)}
.tab-btn.active{background:transparent;border-bottom-color:var(--t2o-accent);color:var(--t2o-fg);font-weight:var(--t2o-fw-semibold)}
.tab-count{margin-left:4px;font:var(--t2o-fs-xs)/1 var(--t2o-mono);color:var(--t2o-fail)}
.tab-count::before{content:"";display:inline-block;width:7px;height:7px;margin-right:3px;background:currentColor;transform:rotate(45deg)}
section[data-tab]{display:none}
section[data-tab].active{display:block}
.config-table td:first-child{width:220px;color:var(--t2o-fg-muted)}
.config-table td:last-child{color:var(--t2o-fg)}
.diagnostics{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:12px;border:1px solid var(--t2o-line);background:var(--t2o-surface)}
.diagnostics span{font-size:var(--t2o-fs-sm);color:var(--t2o-fg-soft)}
.support-bundle{display:inline-block;padding:7px 11px;border:1px solid var(--t2o-accent);border-radius:var(--t2o-radius-control);background:var(--t2o-accent);color:var(--t2o-on-accent);font:var(--t2o-fw-semibold) var(--t2o-fs-sm)/1.2 var(--t2o-sans)}
.support-bundle:hover{text-decoration:none;background:var(--t2o-accent-hover)}
.info-callout,.failure-callout,.switched-off{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;margin-bottom:10px;border:1px solid var(--t2o-line);background:var(--t2o-surface);color:var(--t2o-fg-soft)}
.info-callout>svg,.failure-callout>svg,.switched-off>svg{flex:0 0 auto;margin-top:2px}
.info-callout>svg{color:var(--t2o-accent)}
.failure-callout{border-color:var(--t2o-fail)}
.failure-callout>svg{color:var(--t2o-fail)}
.switched-off>svg{color:var(--t2o-fg-muted)}
.callout-copy{min-width:0;flex:1}
.callout-title{display:block;font:var(--t2o-fw-semibold) var(--t2o-fs-md)/1.3 var(--t2o-sans);color:var(--t2o-fg)}
.callout-body{display:block;margin-top:3px;font-size:var(--t2o-fs-sm);line-height:1.5}
.callout-detail{display:block;margin-top:4px;font:var(--t2o-fs-xs)/1.4 var(--t2o-mono);overflow-wrap:anywhere}
.info-actions{display:flex;align-items:center;gap:8px;margin-left:auto;flex:0 0 auto}
.dev-prose{font-family:var(--t2o-sans);font-size:var(--t2o-fs-sm)}
.source-chip{font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs)}
.source-chip.source-derived::before{display:inline-block;width:7px;height:7px;margin-right:2px;border-radius:50%;background:currentColor}
.source-chip.source-override{color:var(--t2o-warn)}
.source-chip svg{width:11px;height:11px;flex:0 0 auto}
.ifx-state-disagree{color:var(--t2o-fail)}
.card.value-accent .v{color:var(--t2o-accent)}
.card.value-warn .v{color:var(--t2o-warn)}
.card.value-fail .v{color:var(--t2o-fail)}
[hidden]{display:none!important}
.cinfo-tip{position:fixed;left:0;top:0;z-index:50;display:none;width:360px;max-height:340px;overflow:auto;background:var(--t2o-raised);border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-overlay);padding:10px 12px;box-shadow:0 8px 24px rgba(0,0,0,.5);font-weight:400;text-transform:none;letter-spacing:normal;white-space:normal;text-align:left;cursor:auto}
.t2o-info{color:var(--t2o-fg-muted)}
:focus-visible{outline:2px solid var(--t2o-accent);outline-offset:2px}
.tab-btn:focus-visible{outline-offset:-2px}
@media (max-width:760px){
  .cards{grid-template-columns:repeat(2,minmax(0,1fr))}
  .rollup{grid-template-columns:repeat(2,minmax(0,1fr))}
  .rollup .rc{border-bottom:1px solid var(--t2o-line)}
  .rollup .rc:nth-child(2n){border-right:0}
}
@media (prefers-reduced-motion:reduce){
  .t2o-pulse{animation:none}
  .t2o-arrive{animation:none}
}
@keyframes t2o-pulse{0%,100%{opacity:1}50%{opacity:.45}}
@keyframes t2o-arrive{from{opacity:0;transform:translateY(-2px)}to{opacity:1;transform:none}}
</style>
<script>
  // Apply the persisted theme BEFORE first paint to avoid a flash of the wrong
  // theme. Falls back silently to the prefers-color-scheme media query.
  (function(){try{var t=localStorage.getItem('opnsense-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
</script>
<script>window.__refreshMs = {{if .RefreshMs}}{{.RefreshMs}}{{else}}5000{{end}};</script>
<noscript><style>
  section[data-tab]{display:block!important;margin-bottom:34px}
  nav.tabs{display:none}
</style></noscript>
</head>
<body>
{{with .Data}}
<header>
  <h1>{{.Service.Name}}</h1>
  <span class="ver">{{.Service.Version}} · {{.Service.GoVersion}}{{if .Service.Host}} · {{.Service.Host}}{{end}}{{if .Service.Instance}} · {{.Service.Instance}}{{end}}{{if .Service.Uptime}} · up {{.Service.Uptime}}{{end}}</span>
  <span class="spacer"></span>
  <button class="ctl" id="themeToggle" title="Toggle light/dark theme" aria-label="Toggle theme"><svg viewBox="0 0 256 256" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm8,16.37a86.4,86.4,0,0,1,16,3V212.67a86.4,86.4,0,0,1-16,3Zm32,9.26a87.81,87.81,0,0,1,16,10.54V195.83a87.81,87.81,0,0,1-16,10.54ZM40,128a88.11,88.11,0,0,1,80-87.63V215.63A88.11,88.11,0,0,1,40,128Zm160,50.54V77.46a87.82,87.82,0,0,1,0,101.08Z"/></svg></button>
  <span class="badge badge-{{healthClass .Health}}" id="healthBadge" title="{{range .Reasons}}{{.}}&#10;{{end}}">{{.Health}}</span>
  <span class="badge badge-{{upstreamClass .Upstream.State}}" id="upstreamBadge" title="{{if .Upstream.Reason}}{{.Upstream.Reason}}{{else}}OPNsense API health check{{end}} · last checked {{.Upstream.CheckedAgo}}">box {{.Upstream.State}}</span>
  <span class="badge badge-{{captureClass .Capture.State}}" id="captureBadge" title="Passive metric capture: {{.Capture.State}}{{if .Capture.ErrorCount}} · {{.Capture.ErrorCount}} erroring gathers, last {{.Capture.LastErrorAgo}}{{end}}">capture {{.Capture.State}}</span>
  <span class="ver" id="scrapeAge" data-scrape-age>as of {{.ScrapeAge}}</span>
</header>
<div class="reasons" id="healthReasons" role="status"{{if not .Reasons}} style="display:none"{{end}}><svg viewBox="0 0 256 256" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm-8-80V80a8,8,0,0,1,16,0v56a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,172Z"/></svg><span class="reasons-text">{{range .Reasons}}{{.}} · {{end}}</span></div>
{{end}}
<div id="staleBanner" role="alert"></div>
<nav class="tabs" id="tabs" role="tablist" aria-label="Status sections">
  <button class="tab-btn" id="tab-overview" data-target="overview" role="tab" aria-controls="panel-overview" aria-selected="true" tabindex="0">Overview</button>
  <button class="tab-btn" id="tab-collectors" data-target="collectors" role="tab" aria-controls="panel-collectors" aria-selected="false" tabindex="-1">Collectors<span class="tab-count" id="collectorsTabCount" hidden></span></button>
  <button class="tab-btn" id="tab-api" data-target="api" role="tab" aria-controls="panel-api" aria-selected="false" tabindex="-1">API</button>
  <button class="tab-btn" id="tab-cardinality" data-target="cardinality" role="tab" aria-controls="panel-cardinality" aria-selected="false" tabindex="-1">Cardinality<span class="tab-count" id="cardinalityTabCount" hidden></span></button>
  <button class="tab-btn" id="tab-pipeline" data-target="pipeline" role="tab" aria-controls="panel-pipeline" aria-selected="false" tabindex="-1">Logs / Flow</button>
  {{if not .DisableDevices}}<button class="tab-btn" id="tab-devices" data-target="devices" role="tab" aria-controls="panel-devices" aria-selected="false" tabindex="-1">Devices</button>{{end}}
  <button class="tab-btn" id="tab-ifindex" data-target="ifindex" role="tab" aria-controls="panel-ifindex" aria-selected="false" tabindex="-1">ifIndex<span class="tab-count" id="ifxTabCount" hidden></span></button>
  {{if not .DisableConfig}}<button class="tab-btn" id="tab-config" data-target="config" role="tab" aria-controls="panel-config" aria-selected="false" tabindex="-1">Config</button>{{end}}
</nav>
<main>
{{with .Data}}

  <!-- ═══ OVERVIEW ═══ -->
  <section data-tab="overview" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0">
    <div class="rollup" id="rollup">
      <div class="rc"><span class="rv" id="ruHealth">{{.Health}}</span><span class="rk">health</span></div>
      <div class="rc"><span class="rv" id="ruUpstream">{{.Upstream.State}}</span><span class="rk">box</span></div>
      <div class="rc"><span class="rv" id="ruCollectors">-</span><span class="rk">collectors ok</span></div>
      <div class="rc"><span class="rv" id="ruFailing">-</span><span class="rk">failing</span></div>
      <div class="rc"><span class="rv" id="ruStale">-</span><span class="rk">stale</span></div>
      <div class="rc"><span class="rv" id="ruSeries">{{.Stats.Series}}</span><span class="rk">series</span></div>
    </div>
    <div class="cards">
      <div class="card"><div class="k">Uptime</div><div class="v" id="uptime">{{.Service.Uptime}}</div><div class="sub">since {{.Service.Start}}</div></div>
      <div class="card" title="The OPNsense box itself, from the scheduler's health poll. Independent of collector run history - during a transport outage collector polls are skipped entirely, so the collector table stays green."><div class="k">OPNsense API</div><div class="v" id="ovUpstream">{{.Upstream.State}}</div><div class="sub" id="ovUpstreamSub">checked {{.Upstream.CheckedAgo}}</div></div>
      <div class="card" title="Whether the metric capture this page is rendered from came from a clean gather or one that also returned an error. A partial capture is CURRENT data, not stale data."><div class="k">Metric capture</div><div class="v" id="ovCapture">{{.Capture.State}}</div><div class="sub" id="ovCaptureSub">{{if .Capture.ErrorCount}}{{.Capture.ErrorCount}} erroring gathers{{else}}no gather errors{{end}}</div></div>
      <div class="card"><div class="k">Active collectors</div><div class="v" id="ovCollectors">{{.Stats.ActiveCollectors}}</div></div>
      <div class="card"><div class="k">Metric families</div><div class="v" id="ovFamilies">{{.Stats.MetricFamilies}}</div></div>
      <div class="card"><div class="k">Series</div><div class="v" id="ovSeries">{{.Stats.Series}}</div></div>
      <div class="card"><div class="k">Goroutines</div><div class="v" id="goroutines">{{.Runtime.Goroutines}}</div><div class="sub">GOMAXPROCS {{.Runtime.GOMAXPROCS}}</div></div>
      <div class="card"><div class="k">Heap in use</div><div class="v" id="heapAlloc">{{.Runtime.HeapAlloc}}</div><div class="sub">GC cycles <span id="numGC">{{.Runtime.NumGC}}</span></div></div>
      <div class="card"><div class="k">GC rate</div><div class="v" id="gcRate">-</div><div class="sub">cycles/sec</div></div>
    </div>
    <div class="sub-h">Runtime trend (~10 min)</div>
    <div class="cards">
      <div class="card"><div class="k">Goroutines</div><div class="chart-wrap"><svg class="chart" id="chGoroutines"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">Heap in use</div><div class="chart-wrap"><svg class="chart" id="chHeap"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">GC rate</div><div class="chart-wrap"><svg class="chart" id="chGC"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">Active series</div><div class="chart-wrap"><svg class="chart" id="chCard"></svg><div class="chart-tip"></div></div></div>
    </div>
    <div class="sub-h">Throughput &amp; fleet trend (~10 min)</div>
    <div class="cards">
      <div class="card"><div class="k">Records shipped</div><div class="v" id="tpShipped">{{if .Trend.LogShipping}}{{printf "%.2f" .Trend.ShippedRate}}{{else}} - {{end}}</div><div class="sub">log records/sec (OTLP)</div></div>
      <div class="card"><div class="k">Records dropped</div><div class="v" id="tpDropped">{{if .Trend.LogShipping}}{{printf "%.2f" .Trend.DroppedRate}}{{else}} - {{end}}</div><div class="sub">log records/sec lost</div></div>
      <div class="card"><div class="k">Collectors active</div><div class="v" id="flActive">{{.Trend.ActiveCollectors}}</div><div class="sub">tracked by the scheduler</div></div>
      <div class="card"><div class="k">Collectors failing</div><div class="v" id="flFailing">{{.Trend.FailingCollectors}}</div><div class="sub">last run failed</div></div>
      <div class="card"><div class="k">Mean run duration</div><div class="v" id="flMeanMs">{{printf "%.1f" .Trend.MeanDurationMs}} ms</div><div class="sub">across collectors that have run</div></div>
    </div>
    <div class="cards">
      <div class="card"><div class="k">Emitted throughput</div><div class="chart-wrap"><svg class="chart" id="chEmit"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">Collectors failing</div><div class="chart-wrap"><svg class="chart" id="chFailing"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">Mean run duration</div><div class="chart-wrap"><svg class="chart" id="chDuration"></svg><div class="chart-tip"></div></div></div>
    </div>
  </section>

  <!-- ═══ COLLECTORS ═══ -->
  <section data-tab="collectors" id="panel-collectors" role="tabpanel" aria-labelledby="tab-collectors" tabindex="0">
    <input class="filter" type="text" placeholder="Filter collectors…" oninput="filterTable(this,'collTable')">
    <table id="collTable">
      <thead><tr>
        <th>Collector</th><th>State</th><th class="num">Interval</th><th class="num">Success</th>
        <th title="Age of the metric buffer actually being served  -  NOT the age of the last poll attempt">Data age</th>
        <th title="When the last poll attempt finished, successful or not">Last attempt</th>
        <th class="num">Runs</th><th class="num">Fails</th><th class="num">Next run</th>
        <th class="num">Last (ms)</th><th>Trend</th><th>Recent</th><th>Last error</th>
      </tr></thead>
      <tbody id="collBody">
      {{range .Collectors}}
        <tr data-name="{{.Name}}"{{if and .HasRun (not .LastSuccess)}} class="t2o-row--alert"{{end}}>
          <td>{{.Display}}</td>
          <td><span class="dot dot-{{stateClass .State}}"></span>{{.State}}</td>
          <td class="num">{{if .IntervalSec}}{{.IntervalSec}}s{{else}}<span class="muted"> - </span>{{end}}</td>
          <td class="num">{{pct .SuccessRate}}</td>
          <td>{{if eq .FreshnessState "none"}}<span class="badge badge-pending">no data</span>{{else}}<span class="badge badge-{{freshClass .FreshnessState}}" title="{{if .LastSuccessAgo}}last clean poll {{.LastSuccessAgo}}{{else}}never fully succeeded{{end}}">{{.Freshness}}</span>{{end}}</td>
          <td class="mono">{{if .AttemptAge}}{{.AttemptAge}}{{else}}<span class="muted"> - </span>{{end}}</td>
          <td class="num">{{.Runs}}</td>
          <td class="num">{{.Failures}}{{if gt .Consecutive 0}} <span class="muted">({{.Consecutive}}×)</span>{{end}}</td>
          <td class="num">{{if .Scheduled}}{{.NextRunIn}}{{else}}<span class="muted">{{.NextRunIn}}</span>{{end}}</td>
          <td class="num">{{printf "%.1f" .LastDurationMs}}</td>
          <td>{{.Sparkline}}</td>
          <td>{{.Outcomes}}</td>
          <td class="mono">{{if .LastError}}{{.LastError}}{{else}}<span class="muted"> - </span>{{end}}</td>
        </tr>
      {{else}}
        <tr><td colspan="13" class="empty">No collector has run yet  -  waiting for the first poll.</td></tr>
      {{end}}
      </tbody>
    </table>
  </section>

  <!-- ═══ API ═══ -->
  <section data-tab="api" id="panel-api" role="tabpanel" aria-labelledby="tab-api" tabindex="0">
    <div class="cards" style="margin-bottom:12px">
      <div class="card"><div class="k">Auth errors (lifetime)</div><div class="v"><span class="badge badge-{{if .API.AuthOK}}ok{{else}}bad{{end}}" id="apiAuth">{{if .API.AuthOK}}none recorded{{else}}errors recorded{{end}}</span></div></div>
      <div class="card"><div class="k">Requests (lifetime)</div><div class="v" id="apiRequests">{{printf "%.0f" .API.Requests}}</div></div>
      <div class="card"><div class="k">Avg duration (lifetime)</div><div class="v" id="apiAvg">{{printf "%.1f" .API.AvgMs}} ms</div></div>
    </div>
    <div class="sub-h">Permission failures (401/403)</div>
    <table>
      <thead><tr><th>Endpoint</th><th>Code</th><th>Collector</th><th>Component</th><th>Grant this privilege</th><th class="num">Count</th></tr></thead>
      <tbody id="apiAuthzBody">
      {{range .API.AuthFailures}}
        <tr title="{{.Hint}}"><td class="mono">{{.Endpoint}}</td><td>{{.Code}}</td><td>{{.Collector}}</td><td class="mono">{{.Component}}</td><td class="mono">{{.Privilege}}{{if eq .ACLStatus "unknown"}} (no narrower ACL exists){{end}}</td><td class="num">{{printf "%.0f" .Count}}</td></tr>
      {{else}}
        <tr><td colspan="6" class="empty">No permission failures recorded.</td></tr>
      {{end}}
      </tbody>
    </table>
    <div class="sub-h">Top endpoint errors</div>
    <table>
      <thead><tr><th>Endpoint</th><th class="num">Errors</th></tr></thead>
      <tbody id="apiBody">
      {{range .API.TopErrors}}
        <tr><td class="mono">{{.Endpoint}}</td><td class="num">{{printf "%.0f" .Count}}</td></tr>
      {{else}}
        <tr><td colspan="2" class="empty">No endpoint errors recorded.</td></tr>
      {{end}}
      </tbody>
    </table>
  </section>

  <!-- ═══ CARDINALITY ═══ -->
  <section data-tab="cardinality" id="panel-cardinality" role="tabpanel" aria-labelledby="tab-cardinality" tabindex="0">
    <div class="cards" style="margin-bottom:12px">
      <div class="card"><div class="k">Total series</div><div class="v" id="cardTotal">{{.Cardinality.TotalSeries}}</div><div class="sub">across <span id="cardFamilies">{{.Cardinality.TotalFamilies}}</span> families</div></div>
      <div class="card"><div class="k">Review (≥ warn)</div><div class="v" id="cardWarn">{{.Cardinality.Warn}}</div><div class="sub">warn ≥ {{.Cardinality.WarnThreshold}}</div></div>
      <div class="card"><div class="k">Alerts (≥ crit)</div><div class="v" id="cardCrit">{{.Cardinality.Crit}}</div><div class="sub">crit ≥ {{.Cardinality.CritThreshold}}</div></div>
      <div class="card"><div class="k">Series budget</div><div class="v" id="cardBudget">{{if .Cardinality.SeriesBudget}}{{printf "%.0f%%" .Cardinality.BudgetPercent}}{{else}}off{{end}}</div><div class="sub" id="cardBudgetSub">{{if .Cardinality.SeriesBudget}}{{.Cardinality.TotalSeries}} of {{.Cardinality.SeriesBudget}}{{if .Cardinality.OverBudget}} <span class="badge badge-bad">over</span>{{end}}{{else}}disabled{{end}}</div></div>
    </div>
    <div class="sub-h">Top metrics by series</div>
    <input class="filter" type="text" placeholder="Filter metrics…" oninput="filterTable(this,'cardMetrics')">
    <div class="scroll"><table id="cardMetrics">
      <thead><tr><th>Metric</th><th>Level</th><th class="num">Series</th><th class="num">Labels</th></tr></thead>
      <tbody id="cardMetricsBody">
      {{range .Cardinality.TopMetrics}}
        <tr{{if eq .Level "crit"}} class="t2o-row--alert"{{end}}><td class="mono">{{.Name}}</td><td>{{if eq .Level "crit"}}<span class="badge badge-bad">{{.Level}}</span>{{else if eq .Level "warn"}}<span class="badge badge-warn">{{.Level}}</span>{{else}}<span class="badge badge-neutral">ok</span>{{end}}</td><td class="num">{{.Series}}</td><td class="num">{{.Labels}}</td></tr>
      {{else}}
        <tr><td colspan="4" class="empty">No metrics captured yet.</td></tr>
      {{end}}
      </tbody>
    </table></div>
    <div class="sub-h">High-cardinality labels</div>
    <div class="scroll"><table id="cardLabels">
      <thead><tr><th>Label</th><th class="num">Distinct values</th><th class="num">Families</th></tr></thead>
      <tbody id="cardLabelsBody">
      {{range .Cardinality.TopLabels}}
        <tr><td class="mono">{{.Name}}</td><td class="num">{{.DistinctValues}}</td><td class="num">{{.Families}}</td></tr>
      {{else}}
        <tr><td colspan="3" class="empty">No labels captured yet.</td></tr>
      {{end}}
      </tbody>
    </table></div>
    {{if .Cardinality.Growth}}
    <div class="sub-h">Growth (per minute over the retained window)</div>
    <div class="scroll"><table id="cardGrowth">
      <thead><tr><th>Metric</th><th class="num">Series</th><th class="num">Per min</th></tr></thead>
      <tbody>
      {{range .Cardinality.Growth}}
        <tr><td class="mono">{{.Name}}</td><td class="num">{{.Series}}</td><td class="num">{{if gt .PerMin 0.0}}<span style="color:var(--warn)">+{{printf "%.1f" .PerMin}}</span>{{else}}<span style="color:var(--ok)">{{printf "%.1f" .PerMin}}</span>{{end}}</td></tr>
      {{end}}
      </tbody>
    </table></div>
    {{end}}
    <p class="note" style="margin-top:12px;color:var(--muted)">Full export: <a href="/cardinality/export.json"><code>/cardinality/export.json</code></a> · <a href="/api/cardinality.json"><code>/api/cardinality.json</code></a></p>
  </section>


  <!-- ═══ LOGS / FLOW ═══ -->
  <section data-tab="pipeline" id="panel-pipeline" role="tabpanel" aria-labelledby="tab-pipeline" tabindex="0">
    <div class="info-callout" role="note">
      <svg viewBox="0 0 256 256" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"/></svg>
      <div class="callout-copy"><span class="callout-title">Logs / Flow pipeline</span><span class="callout-body">Receiver and flow-pipeline self-metrics from the last passive metric capture. This tab never performs a live registry gather.</span></div>
    </div>
    <div class="sub-h">Input rejected</div>
    <div class="scroll"><table id="pipelineRejects">
      <thead><tr><th>Source</th><th>Reason</th><th class="num">Count</th></tr></thead>
      <tbody id="pipelineRejectBody">
      {{range .Pipeline.Rejects}}
        <tr><td class="mono">{{.Source}}</td><td class="mono">{{.Reason}}</td><td class="num">{{printf "%.0f" .Count}}</td></tr>
      {{else}}
        <tr><td colspan="3" class="empty">No receiver rejection metrics captured yet.</td></tr>
      {{end}}
      </tbody>
    </table></div>

    <div class="sub-h">Parse errors</div>
    <div class="scroll"><table id="pipelineParseErrors">
      <thead><tr><th>Source</th><th>Stage</th><th class="num">Count</th></tr></thead>
      <tbody id="pipelineParseBody">
      {{range .Pipeline.ParseErrors}}
        <tr><td class="mono">{{.Source}}</td><td class="mono">{{.Stage}}</td><td class="num">{{printf "%.0f" .Count}}</td></tr>
      {{else}}
        <tr><td colspan="3" class="empty">No parse errors captured yet.</td></tr>
      {{end}}
      </tbody>
    </table></div>

    <div class="sub-h">Flow Rollup</div>
    <div class="cards" style="margin-bottom:12px">
      <div class="card"><div class="k">Tracked keys</div><div class="v" id="pipelineRollupKeys">{{if .Pipeline.Flow.RollupAvailable}}{{printf "%.0f" .Pipeline.Flow.RollupKeys}}{{else}} - {{end}}</div><div class="sub">live accumulator entries</div></div>
      <div class="card"><div class="k">Max keys</div><div class="v" id="pipelineRollupKeysMax">{{if .Pipeline.Flow.RollupAvailable}}{{printf "%.0f" .Pipeline.Flow.RollupKeysMax}}{{else}} - {{end}}</div><div class="sub">configured memory ceiling</div></div>
      <div class="card"><div class="k">Top-N</div><div class="v" id="pipelineRollupTopN">{{if .Pipeline.Flow.RollupAvailable}}{{printf "%.0f" .Pipeline.Flow.RollupTopN}}{{else}} - {{end}}</div><div class="sub">emitted-series ceiling</div></div>
      <div class="card"><div class="k">Folded keys</div><div class="v" id="pipelineRollupFolded">{{if .Pipeline.Flow.RollupAvailable}}{{printf "%.0f" .Pipeline.Flow.RollupKeysFolded}}{{else}} - {{end}}</div><div class="sub">outside top-N</div></div>
      <div class="card"><div class="k">Rollup capping</div><div class="v" id="pipelineRollupCapped">{{if .Pipeline.Flow.RollupAvailable}}{{printf "%.0f" .Pipeline.Flow.RollupCapped}}{{else}} - {{end}}</div><div class="sub">records folded at max-keys</div></div>
    </div>

    <div class="sub-h">Correlator</div>
    <div class="cards">
      <div class="card"><div class="k">Occupancy</div><div class="v" id="pipelineCorrEntries">{{if .Pipeline.Flow.CorrelatorAvailable}}{{printf "%.0f" .Pipeline.Flow.CorrelatorEntries}}{{else}} - {{end}}</div><div class="sub">connection windows held</div></div>
      <div class="card"><div class="k">Emitted</div><div class="v" id="pipelineCorrEmitted">{{if .Pipeline.Flow.CorrelatorAvailable}}{{printf "%.0f" .Pipeline.Flow.CorrelatorEmitted}}{{else}} - {{end}}</div><div class="sub">flow-log records</div></div>
      <div class="card"><div class="k">Matched</div><div class="v" id="pipelineCorrMatched">{{if .Pipeline.Flow.CorrelatorAvailable}}{{printf "%.0f" .Pipeline.Flow.CorrelatorMatched}}{{else}} - {{end}}</div><div class="sub">with Zenarmor enrichment</div></div>
      <div class="card"><div class="k">Evicted</div><div class="v" id="pipelineCorrEvicted">{{if .Pipeline.Flow.CorrelatorAvailable}}{{printf "%.0f" .Pipeline.Flow.CorrelatorEvicted}}{{else}} - {{end}}</div><div class="sub">forced early at capacity</div></div>
      <div class="card"><div class="k">Expired</div><div class="v" id="pipelineCorrExpired">{{if .Pipeline.Flow.CorrelatorAvailable}}{{printf "%.0f" .Pipeline.Flow.CorrelatorExpired}}{{else}} - {{end}}</div><div class="sub">normal window expiry</div></div>
      <div class="card"><div class="k">Enrichment overwrites</div><div class="v" id="pipelineCorrOverwrites">{{if .Pipeline.Flow.CorrelatorAvailable}}{{printf "%.0f" .Pipeline.Flow.CorrelatorEnrichmentOverwrites}}{{else}} - {{end}}</div><div class="sub">second document replaced first</div></div>
      <div class="card"><div class="k">Fragment disagreements</div><div class="v" id="pipelineCorrDisagreements">{{if .Pipeline.Flow.CorrelatorAvailable}}{{printf "%.0f" .Pipeline.Flow.CorrelatorFragmentDisagreements}}{{else}} - {{end}}</div><div class="sub">same-orientation dimension mismatch</div></div>
      <div class="card"><div class="k">Mirrored fragments</div><div class="v" id="pipelineCorrMirrored">{{if .Pipeline.Flow.CorrelatorAvailable}}{{printf "%.0f" .Pipeline.Flow.CorrelatorFragmentMirrored}}{{else}} - {{end}}</div><div class="sub">expected reverse direction</div></div>
    </div>
  </section>

  <!-- ═══ DEVICES ═══ -->
  {{if not $.DisableDevices}}
  <section data-tab="devices" id="panel-devices" role="tabpanel" aria-labelledby="tab-devices" tabindex="0">
    <div class="info-callout" role="note">
      <svg viewBox="0 0 256 256" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"/></svg>
      <div class="callout-copy"><span class="callout-title">Connected devices</span><span class="callout-body">Merged from the ARP table + DHCPv4/DHCPv6 leases. This is the only console tab that reaches the firewall, and it never touches metric collection. <span class="mono" id="devMatch">- of -</span> · <span class="mono" id="devCacheAge">cached -</span></span></div>
      <div class="info-actions"><button class="ctl" id="devReload" type="button"><svg viewBox="0 0 256 256" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M232,128a104,104,0,1,1-30.53-73.54,8,8,0,0,1-11.33,11.31A88,88,0,1,0,216,128a8,8,0,0,1,16,0Z"/><path d="M232,48V96a8,8,0,0,1-8,8H176a8,8,0,0,1,0-16h40V48a8,8,0,0,1,16,0Z"/></svg> Reload</button></div>
    </div>
    <div id="devError" class="failure-callout" role="alert" hidden></div>
    <input class="filter" type="text" placeholder="Filter devices…" oninput="filterTable(this,'devTable')">
    <div class="scroll"><table id="devTable">
      <thead><tr><th>IP</th><th>MAC</th><th>Hostname</th><th>Interface</th><th>Manufacturer</th><th>Source</th><th>Expiry</th></tr></thead>
      <tbody id="devBody"><tr><td colspan="7" class="empty">Open this tab to load devices.</td></tr></tbody>
    </table></div>
  </section>
  {{end}}
{{end}}

  <!-- ═══ IFINDEX ═══ -->
  <section data-tab="ifindex" id="panel-ifindex" role="tabpanel" aria-labelledby="tab-ifindex" tabindex="0">
    <div class="info-callout" role="note">
      <svg viewBox="0 0 256 256" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"/></svg>
      <div class="callout-copy"><span class="callout-title">ifIndex mapping</span><span class="callout-body">A NetFlow <code>ifIndex</code> is a <strong>1-based position over <code>/usr/local/sbin/ifinfo</code> output</strong>, which OPNsense turns into the netgraph hook name <code>ifaceN</code>. It is not an OS or SNMP index and nothing pins it: adding or removing <em>any</em> interface renumbers every interface after it. Compare this table straight down against <code>ifinfo</code> on the firewall after any interface change - the exporter can only derive this mapping, so a silent divergence here mislabels every flow. Loads on demand - not on the auto-refresh poll.</span></div>
      <div class="info-actions"><button class="ctl" id="ifxReload" type="button"><svg viewBox="0 0 256 256" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M232,128a104,104,0,1,1-30.53-73.54,8,8,0,0,1-11.33,11.31A88,88,0,1,0,216,128a8,8,0,0,1,16,0Z"/><path d="M232,48V96a8,8,0,0,1-8,8H176a8,8,0,0,1,0-16h40V48a8,8,0,0,1,16,0Z"/></svg> Reload</button></div>
    </div>
    <div id="ifxError" class="failure-callout" role="alert" hidden></div>
    <div class="cards" style="margin-bottom:12px">
      <div class="card"><div class="k">Entries</div><div class="v" id="ifxEntries"> - </div><div class="sub">resolved ifIndex rows</div></div>
      <div class="card value-accent"><div class="k">Overridden</div><div class="v" id="ifxOverridden"> - </div><div class="sub">from the operator override</div></div>
      <div class="card value-warn"><div class="k">Conflicts</div><div class="v" id="ifxConflicts"> - </div><div class="sub">overrides that contradicted the derivation</div></div>
      <div class="card value-fail"><div class="k">Disagreements</div><div class="v" id="ifxDisagreements"> - </div><div class="sub">rows the API states a different index for</div></div>
      <div class="card value-warn"><div class="k">Unmapped lookups</div><div class="v" id="ifxUnmapped"> - </div><div class="sub">flows whose ifIndex resolved to nothing</div></div>
      <div class="card"><div class="k">Built</div><div class="v" id="ifxBuilt"> - </div><div class="sub">when the map was last resolved</div></div>
    </div>
    <input class="filter" type="text" placeholder="Filter interfaces…" oninput="filterTable(this,'ifxTable')">
    <div class="scroll"><table id="ifxTable">
      <thead><tr><th class="num">ifIndex</th><th>Device</th><th>Description</th><th>Source</th><th class="num">API states</th><th>Notes</th></tr></thead>
      <tbody id="ifxBody"><tr><td colspan="6" class="empty">Open this tab to load the resolved ifIndex map.</td></tr></tbody>
    </table></div>
  </section>

  <!-- ═══ CONFIG ═══ -->
  {{if not .DisableConfig}}
  <section data-tab="config" id="panel-config" role="tabpanel" aria-labelledby="tab-config" tabindex="0">
    {{range .Config}}
    <div class="sub-h">{{.Title}}</div>
    <table class="config-table" style="margin-bottom:18px">
      <thead><tr><th>Setting</th><th>Value</th></tr></thead>
      <tbody>
      {{range .Items}}
        <tr><td>{{if .Display}}{{.Display}} <code class="muted">{{.Key}}</code>{{else}}{{.Key}}{{end}}</td><td class="mono">{{if .Secret}}<span class="badge badge-pending" data-redacted="{{if eq .Value "••••"}}••••{{end}}">{{if eq .Value "••••"}}set{{else}}unset{{end}}</span>{{else}}{{.Value}}{{end}}</td></tr>
      {{else}}
        <tr><td colspan="2" class="empty">No items.</td></tr>
      {{end}}
      </tbody>
    </table>
    {{else}}
    <p class="empty">No configuration sections available.</p>
    {{end}}
    <div class="sub-h">Diagnostics</div>
    <div class="diagnostics">
      <a class="support-bundle" href="/api/support-bundle.zip"><svg viewBox="0 0 256 256" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M224,144v64a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V144a8,8,0,0,1,16,0v56H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z"/></svg> Download support bundle</a>
      <a class="ctl" href="/api/config.json">View redacted config</a>
      <span>Contains runtime diagnostics, recent logs, and redacted configuration; omits API keys, secrets, and other credentials.</span>
    </div>
  </section>
  {{end}}

</main>
<footer>
  Generated at <span id="generatedAt">{{with .Data}}{{.Generated.Format "15:04:05"}}{{end}}</span> ·
  <a href="/api/status.json">JSON</a> ·
  <span class="controls"><button class="ctl" id="pauseBtn">Pause</button> <a href="#" id="refreshNow">refresh now</a></span> ·
  updated <span id="updatedAgo">just now</span> ·
  <noscript>static snapshot (enable JavaScript for live updates &amp; charts)</noscript>
  <br>
  <span class="attribution">{{geoipCredit}}</span>
</footer>
<script>
var SVGNS='http://www.w3.org/2000/svg';
var lastOkMs=Date.now(), pollTimer=null, paused=false, lastData=null, devicesLoaded=false, ifIndexLoaded=false;

// ── Tabs ──────────────────────────────────────────────────────────────────
function showTab(id){
  var secs=document.querySelectorAll('section[data-tab]'), found=false;
  for(var i=0;i<secs.length;i++){ var on=secs[i].getAttribute('data-tab')===id; secs[i].classList.toggle('active',on); secs[i].setAttribute('aria-hidden',on?'false':'true'); if(on) found=true; }
  var btns=document.querySelectorAll('#tabs .tab-btn');
  for(var j=0;j<btns.length;j++){ var selected=btns[j].getAttribute('data-target')===id; btns[j].classList.toggle('active',selected); btns[j].setAttribute('aria-selected',selected?'true':'false'); btns[j].setAttribute('tabindex',selected?'0':'-1'); }
  if(found && location.hash!=='#'+id){ history.replaceState(null,'','#'+id); }
  if(id==='devices' && !devicesLoaded){ loadDevices(); }
  if(id==='ifindex' && !ifIndexLoaded){ loadIfIndex(); }
  redrawCharts();
}
function tabSection(id){
  var secs=document.querySelectorAll('section[data-tab]');
  for(var i=0;i<secs.length;i++){ if(secs[i].getAttribute('data-tab')===id) return secs[i]; }
  return null;
}
function handleTabsKeydown(ev){
  var btns=Array.prototype.slice.call(document.querySelectorAll('#tabs .tab-btn')); if(!btns.length) return;
  var current=btns.indexOf(ev.currentTarget); if(current<0) return;
  var next=-1;
  if(ev.key==='ArrowRight' || ev.key==='ArrowDown') next=(current+1)%btns.length;
  else if(ev.key==='ArrowLeft' || ev.key==='ArrowUp') next=(current+btns.length-1)%btns.length;
  else if(ev.key==='Home') next=0;
  else if(ev.key==='End') next=btns.length-1;
  if(next<0) return;
  ev.preventDefault(); btns[next].focus(); showTab(btns[next].getAttribute('data-target'));
}
function initTabs(){
  var btns=document.querySelectorAll('#tabs .tab-btn');
  for(var i=0;i<btns.length;i++){ (function(b){ b.addEventListener('click',function(){ showTab(b.getAttribute('data-target')); }); b.addEventListener('keydown',handleTabsKeydown); })(btns[i]); }
  var initial=(location.hash||'').replace(/^#/,'');
  var valid=tabSection(initial);
  showTab(valid?initial:'overview');
  window.addEventListener('hashchange',function(){ var id=(location.hash||'').replace(/^#/,''); if(tabSection(id)) showTab(id); });
}

// ── Theme toggle ──────────────────────────────────────────────────────────
function currentTheme(){ var t=document.documentElement.getAttribute('data-theme'); if(t) return t; return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light'; }
function toggleTheme(){ var next=currentTheme()==='light'?'dark':'light'; document.documentElement.setAttribute('data-theme',next); try{localStorage.setItem('opnsense-theme',next);}catch(e){} redrawCharts(); }

// ── Helpers ───────────────────────────────────────────────────────────────
function filterTable(input,tableId){ var q=input.value.toLowerCase(), rows=document.querySelectorAll('#'+tableId+' tbody tr'), visible=0,total=0; for(var i=0;i<rows.length;i++){ if(rows[i].classList.contains('empty')) continue; total++; var match=rows[i].textContent.toLowerCase().indexOf(q)>-1; rows[i].style.display=match?'':'none'; if(match) visible++; } if(tableId==='devTable') setText('devMatch',visible+' of '+total); }
function setText(id,v){ var e=document.getElementById(id); if(e!=null && v!=null) e.textContent=v; }
function el(tag,attrs,text){ var e=document.createElement(tag); if(attrs){ for(var k in attrs){ if(attrs.hasOwnProperty(k)) e.setAttribute(k,attrs[k]); } } if(text!=null) e.textContent=text; return e; }
function cssVar(name){ return getComputedStyle(document.documentElement).getPropertyValue(name).trim()||'#4493f8'; }
function relMs(ms){ var s=Math.round((Date.now()-ms)/1000); if(s<0)s=0; if(s<60)return s+'s ago'; if(s<3600)return Math.floor(s/60)+'m ago'; if(s<86400)return Math.floor(s/3600)+'h ago'; return Math.floor(s/86400)+'d ago'; }
function pct(v){ if(v==null||v<0) return '-'; return Math.round(v)+'%'; }
function stateClass(s){ if(s==='ok')return 'ok'; if(s==='failing')return 'bad'; return 'warn'; }
function freshClass(s){ if(s==='fresh')return 'ok'; if(s==='stale')return 'warn'; return 'pending'; }
function healthClass(h){ if(h==='healthy')return 'ok'; if(h==='degraded')return 'bad'; return 'warn'; }
function setTabCount(id,count){ var e=document.getElementById(id); if(!e) return; if(count>0){ e.hidden=false; e.textContent=String(count); } else { e.hidden=true; e.textContent=''; } }

// ── Charts (zero-dependency line chart with axes + hover) ─────────────────
var CHARTS={};
function registerChart(svgId,seriesFn,fmtFn){ CHARTS[svgId]={seriesFn:seriesFn,fmt:fmtFn||function(v){return String(Math.round(v));}}; }
function redrawCharts(){ for(var id in CHARTS){ if(CHARTS.hasOwnProperty(id)){ var c=CHARTS[id]; drawChart(id,c.seriesFn(lastData),c.fmt); } } }
function drawChart(svgId,series,fmt){
  var svg=document.getElementById(svgId); if(!svg) return;
  var wrap=svg.parentNode, tip=wrap?wrap.querySelector('.chart-tip'):null;
  while(svg.firstChild) svg.removeChild(svg.firstChild);
  series=(series||[]).filter(function(s){ return s.points && s.points.length; });
  var rect=svg.getBoundingClientRect();
  var W=Math.max(rect.width||300,120), H=Math.max(rect.height||150,50);
  svg.setAttribute('viewBox','0 0 '+W+' '+H); svg.setAttribute('preserveAspectRatio','none');
  var maxLen=0,mn=Infinity,mx=-Infinity;
  series.forEach(function(s){ maxLen=Math.max(maxLen,s.points.length); s.points.forEach(function(v){ if(v<mn)mn=v; if(v>mx)mx=v; }); });
  if(!series.length || maxLen<2){ var t=document.createElementNS(SVGNS,'text'); t.setAttribute('x',8); t.setAttribute('y',H/2); t.setAttribute('fill',cssVar('--muted')); t.setAttribute('font-size','11'); t.textContent='collecting…'; svg.appendChild(t); return; }
  if(mn===mx){ mx=mn+1; }
  var padL=44,padR=8,padT=8,padB=16, plotW=W-padL-padR, plotH=H-padT-padB;
  function xAt(i){ return padL+i*plotW/(maxLen-1); }
  function yAt(v){ return padT+(1-(v-mn)/(mx-mn))*plotH; }
  [0,0.5,1].forEach(function(f){ var val=mn+(mx-mn)*f,y=yAt(val); var ln=document.createElementNS(SVGNS,'line'); ln.setAttribute('x1',padL); ln.setAttribute('x2',W-padR); ln.setAttribute('y1',y); ln.setAttribute('y2',y); ln.setAttribute('stroke',cssVar('--grid')); ln.setAttribute('stroke-width','1'); svg.appendChild(ln); var tx=document.createElementNS(SVGNS,'text'); tx.setAttribute('x',4); tx.setAttribute('y',y+3); tx.setAttribute('fill',cssVar('--muted')); tx.setAttribute('font-size','9'); tx.setAttribute('font-family','monospace'); tx.textContent=fmt(val); svg.appendChild(tx); });
  var colors=[cssVar('--accent'),cssVar('--ok'),cssVar('--warn')];
  series.forEach(function(s,si){ var col=s.color||colors[si%colors.length]; var pts=s.points.map(function(v,i){ return xAt(i)+','+yAt(v); }).join(' '); if(si===0){ var area=document.createElementNS(SVGNS,'polygon'); area.setAttribute('points',xAt(0)+','+(padT+plotH)+' '+pts+' '+xAt(s.points.length-1)+','+(padT+plotH)); area.setAttribute('fill',col); area.setAttribute('opacity','0.10'); svg.appendChild(area); } var pl=document.createElementNS(SVGNS,'polyline'); pl.setAttribute('fill','none'); pl.setAttribute('stroke',col); pl.setAttribute('stroke-width','1.5'); pl.setAttribute('points',pts); svg.appendChild(pl); });
  if(tip){
    var cross=document.createElementNS(SVGNS,'line'); cross.setAttribute('stroke',cssVar('--muted')); cross.setAttribute('stroke-width','1'); cross.setAttribute('stroke-dasharray','2 2'); cross.setAttribute('y1',padT); cross.setAttribute('y2',padT+plotH); cross.style.display='none'; svg.appendChild(cross);
    var over=document.createElementNS(SVGNS,'rect'); over.setAttribute('x',padL); over.setAttribute('y',padT); over.setAttribute('width',plotW); over.setAttribute('height',plotH); over.setAttribute('fill','transparent'); svg.appendChild(over);
    over.addEventListener('mousemove',function(ev){ var b=svg.getBoundingClientRect(); var rel=(ev.clientX-b.left)*(W/b.width); var idx=Math.round((rel-padL)/plotW*(maxLen-1)); if(idx<0)idx=0; if(idx>=maxLen)idx=maxLen-1; cross.setAttribute('x1',xAt(idx)); cross.setAttribute('x2',xAt(idx)); cross.style.display=''; var lines=series.map(function(s){ var v=s.points[idx]; return s.name+' '+(v==null?' - ':fmt(v)); }); tip.textContent=lines.join('  ·  '); tip.style.display='block'; tip.style.left=Math.min(Math.max(xAt(idx)*(b.width/W)-tip.offsetWidth/2,0),b.width-tip.offsetWidth)+'px'; tip.style.top='2px'; });
    over.addEventListener('mouseleave',function(){ cross.style.display='none'; tip.style.display='none'; });
  }
}

// ── Collectors table ──────────────────────────────────────────────────────
function rebuildCollectors(rows){
  var tb=document.getElementById('collBody'); if(!tb) return;
  tb.textContent='';
  if(!rows || !rows.length){ setTabCount('collectorsTabCount',0); var tr0=el('tr'); tr0.appendChild(el('td',{'colspan':'13','class':'empty'},'No collector has run yet  -  waiting for the first poll.')); tb.appendChild(tr0); return; }
  var failing=0;
  rows.forEach(function(c){
    var tr=el('tr',{'data-name':c.Name}); if(c.HasRun && !c.LastSuccess){ tr.className='t2o-row--alert'; failing++; }
    tr.appendChild(el('td',null,c.Display));
    var stTd=el('td'); stTd.appendChild(el('span',{'class':'dot dot-'+stateClass(c.State)})); stTd.appendChild(document.createTextNode(c.State)); tr.appendChild(stTd);
    tr.appendChild(el('td',{'class':'num'}, c.IntervalSec?c.IntervalSec+'s':' - '));
    tr.appendChild(el('td',{'class':'num'}, pct(c.SuccessRate)));
    // Data age  -  the age of the metric buffer actually being served. NOT the
    // attempt clock, which keeps refreshing while a failing collector replays
    // hours-old values.
    var frTd=el('td');
    if(c.FreshnessState==='none'){ frTd.appendChild(el('span',{'class':'badge badge-pending'},'no data')); }
    else { var fb=el('span',{'class':'badge badge-'+freshClass(c.FreshnessState)}, c.Freshness||' - '); fb.title=c.LastSuccessAgo?('last clean poll '+c.LastSuccessAgo):'never fully succeeded'; frTd.appendChild(fb); }
    tr.appendChild(frTd);
    // Last attempt  -  the scheduler clock, deliberately its own column.
    var atTd=el('td',{'class':'mono'}); if(c.AttemptAge){ atTd.textContent=c.AttemptAge; } else { atTd.appendChild(el('span',{'class':'muted'},' - ')); } tr.appendChild(atTd);
    tr.appendChild(el('td',{'class':'num'}, String(c.Runs)));
    tr.appendChild(el('td',{'class':'num'}, String(c.Failures)+(c.Consecutive>0?' ('+c.Consecutive+'×)':'')));
    // Next run comes from the scheduler's real deadline; an unscheduled poller
    // says so rather than showing a countdown or claiming a run is due.
    var nrTd=el('td',{'class':'num'});
    if(c.Scheduled){ nrTd.textContent=c.NextRunIn||' - '; } else { nrTd.appendChild(el('span',{'class':'muted'}, c.NextRunIn||'not scheduled')); }
    tr.appendChild(nrTd);
    tr.appendChild(el('td',{'class':'num'}, Number(c.LastDurationMs).toFixed(1)));
    var spTd=el('td'); spTd.innerHTML=c.Sparkline||''; tr.appendChild(spTd);
    var ocTd=el('td'); ocTd.innerHTML=c.Outcomes||''; tr.appendChild(ocTd);
    var erTd=el('td',{'class':'mono'}); if(c.LastError){ erTd.textContent=c.LastError; } else { erTd.appendChild(el('span',{'class':'muted'},' - ')); } tr.appendChild(erTd);
    tb.appendChild(tr);
  });
  setTabCount('collectorsTabCount',failing);
}

// ── API table ─────────────────────────────────────────────────────────────
function rebuildAPI(api){
  if(!api) return;
  var ab=document.getElementById('apiAuth'); if(ab){ ab.textContent=api.AuthOK?'none recorded':'errors recorded'; ab.className='badge badge-'+(api.AuthOK?'ok':'bad'); }
  setText('apiRequests', Math.round(api.Requests||0));
  setText('apiAvg', (api.AvgMs||0).toFixed(1)+' ms');
  var zb=document.getElementById('apiAuthzBody');
  if(zb){ zb.textContent='';
    var az=api.AuthFailures||[];
    if(!az.length){ var trz=el('tr'); trz.appendChild(el('td',{'colspan':'6','class':'empty'},'No permission failures recorded.')); zb.appendChild(trz); }
    else { az.forEach(function(a){ var tr=el('tr',{'title':a.Hint||''});
      tr.appendChild(el('td',{'class':'mono'},a.Endpoint));
      tr.appendChild(el('td',{},a.Code));
      tr.appendChild(el('td',{},a.Collector));
      tr.appendChild(el('td',{'class':'mono'},a.Component));
      tr.appendChild(el('td',{'class':'mono'},a.Privilege + (a.ACLStatus==='unknown' ? ' (no narrower ACL exists)' : '')));
      tr.appendChild(el('td',{'class':'num'},String(Math.round(a.Count))));
      zb.appendChild(tr); }); }
  }
  var tb=document.getElementById('apiBody'); if(!tb) return; tb.textContent='';
  var errs=api.TopErrors||[];
  if(!errs.length){ var tr0=el('tr'); tr0.appendChild(el('td',{'colspan':'2','class':'empty'},'No endpoint errors recorded.')); tb.appendChild(tr0); return; }
  errs.forEach(function(e2){ var tr=el('tr'); tr.appendChild(el('td',{'class':'mono'},e2.Endpoint)); tr.appendChild(el('td',{'class':'num'},String(Math.round(e2.Count)))); tb.appendChild(tr); });
}

// ── Cardinality tables ────────────────────────────────────────────────────
function rebuildCardinality(cd){
  if(!cd) return;
  setText('cardTotal', cd.TotalSeries); setText('cardFamilies', cd.TotalFamilies);
  setText('cardWarn', cd.Warn); setText('cardCrit', cd.Crit);
  setTabCount('cardinalityTabCount',Number(cd.Crit)||0);
  // Series budget (#494). A budget of 0 means the check is disabled entirely,
  // which must read as "off" rather than as 0%  -  0% would look like headroom.
  var bs=document.getElementById('cardBudgetSub');
  if(cd.SeriesBudget){
    setText('cardBudget', Math.round(cd.BudgetPercent)+'%');
    if(bs){ bs.textContent=cd.TotalSeries+' of '+cd.SeriesBudget;
      if(cd.OverBudget){ bs.appendChild(document.createTextNode(' ')); bs.appendChild(el('span',{'class':'badge badge-bad'},'over')); } }
  } else {
    setText('cardBudget', 'off');
    if(bs) bs.textContent='disabled';
  }
  var mb=document.getElementById('cardMetricsBody');
  if(mb){ mb.textContent='';
    var ms=cd.TopMetrics||[];
    if(!ms.length){ var tr0=el('tr'); tr0.appendChild(el('td',{'colspan':'4','class':'empty'},'No metrics captured yet.')); mb.appendChild(tr0); }
    else ms.forEach(function(m){ var tr=el('tr'); if(m.Level==='crit') tr.className='t2o-row--alert'; var nameTd=el('td',{'class':'mono'},m.Name); var levelTd=el('td'); var level=m.Level||'ok'; levelTd.appendChild(el('span',{'class':'badge badge-'+(level==='crit'?'bad':level==='warn'?'warn':'neutral')},level)); tr.appendChild(nameTd); tr.appendChild(levelTd); tr.appendChild(el('td',{'class':'num'},String(m.Series))); tr.appendChild(el('td',{'class':'num'},String(m.Labels))); mb.appendChild(tr); });
  }
  var lb=document.getElementById('cardLabelsBody');
  if(lb){ lb.textContent='';
    var ls=cd.TopLabels||[];
    if(!ls.length){ var tr1=el('tr'); tr1.appendChild(el('td',{'colspan':'3','class':'empty'},'No labels captured yet.')); lb.appendChild(tr1); }
    else ls.forEach(function(l){ var tr=el('tr'); tr.appendChild(el('td',{'class':'mono'},l.Name)); tr.appendChild(el('td',{'class':'num'},String(l.DistinctValues))); tr.appendChild(el('td',{'class':'num'},String(l.Families))); lb.appendChild(tr); });
  }
}

// ── Logs / Flow pipeline ─────────────────────────────────────────────────
function pipelineNumber(v,available){ return available ? String(Math.round(Number(v)||0)) : '-'; }
function rebuildPipeline(p){
  if(!p) return;
  function rows(id,items,secondKey,empty){
    var tb=document.getElementById(id); if(!tb) return; tb.textContent='';
    if(!items || !items.length){ tb.appendChild(el('tr')).appendChild(el('td',{'colspan':'3','class':'empty'},empty)); return; }
    items.forEach(function(x){ var tr=el('tr'); tr.appendChild(el('td',{'class':'mono'},x.Source||'-')); tr.appendChild(el('td',{'class':'mono'},x[secondKey]||'-')); tr.appendChild(el('td',{'class':'num'},String(Math.round(Number(x.Count)||0)))); tb.appendChild(tr); });
  }
  rows('pipelineRejectBody',p.Rejects,'Reason','No receiver rejection metrics captured yet.');
  rows('pipelineParseBody',p.ParseErrors,'Stage','No parse errors captured yet.');
  var f=p.Flow||{}, rollup=f.RollupAvailable, corr=f.CorrelatorAvailable;
  setText('pipelineRollupKeys',pipelineNumber(f.RollupKeys,rollup));
  setText('pipelineRollupKeysMax',pipelineNumber(f.RollupKeysMax,rollup));
  setText('pipelineRollupTopN',pipelineNumber(f.RollupTopN,rollup));
  setText('pipelineRollupFolded',pipelineNumber(f.RollupKeysFolded,rollup));
  setText('pipelineRollupCapped',pipelineNumber(f.RollupCapped,rollup));
  setText('pipelineCorrEntries',pipelineNumber(f.CorrelatorEntries,corr));
  setText('pipelineCorrEmitted',pipelineNumber(f.CorrelatorEmitted,corr));
  setText('pipelineCorrMatched',pipelineNumber(f.CorrelatorMatched,corr));
  setText('pipelineCorrEvicted',pipelineNumber(f.CorrelatorEvicted,corr));
  setText('pipelineCorrExpired',pipelineNumber(f.CorrelatorExpired,corr));
  setText('pipelineCorrOverwrites',pipelineNumber(f.CorrelatorEnrichmentOverwrites,corr));
  setText('pipelineCorrDisagreements',pipelineNumber(f.CorrelatorFragmentDisagreements,corr));
  setText('pipelineCorrMirrored',pipelineNumber(f.CorrelatorFragmentMirrored,corr));
}

// ── Overview roll-up + runtime ────────────────────────────────────────────
function updateRollup(d){
  setText('ruHealth', d.Health);
  if(d.Upstream) setText('ruUpstream', d.Upstream.State);
  var ok=0,failing=0,stale=0;
  (d.Collectors||[]).forEach(function(c){ if(c.HasRun && c.LastSuccess) ok++; if(c.HasRun && !c.LastSuccess) failing++; if(c.FreshnessState==='stale') stale++; });
  setText('ruCollectors',ok); setText('ruFailing',failing); setText('ruStale',stale);
  if(d.Stats) setText('ruSeries', d.Stats.Series);
}
function updateOverview(d){
  if(d.Service) setText('uptime', d.Service.Uptime);
  if(d.Stats){ setText('ovCollectors',d.Stats.ActiveCollectors); setText('ovFamilies',d.Stats.MetricFamilies); setText('ovSeries',d.Stats.Series); }
  if(d.Runtime){ setText('goroutines',d.Runtime.Goroutines); setText('heapAlloc',d.Runtime.HeapAlloc); setText('numGC',d.Runtime.NumGC); var gr=d.Runtime.GCRateSeries; if(gr && gr.length) setText('gcRate', gr[gr.length-1].toFixed(2)+'/s'); }
}
function updateTrend(d){
  var t=d.Trend; if(!t) return;
  // No log-shipping pipeline means no emit boundary at all on a pull exporter, so
  // show a spaced hyphen rather than 0.00/s  -  see TrendStats.LogShipping.
  if(t.LogShipping){ setText('tpShipped',(t.ShippedRate||0).toFixed(2)); setText('tpDropped',(t.DroppedRate||0).toFixed(2)); }
  else { setText('tpShipped',' - '); setText('tpDropped',' - '); }
  setText('flActive', t.ActiveCollectors); setText('flFailing', t.FailingCollectors);
  setText('flMeanMs', (t.MeanDurationMs||0).toFixed(1)+' ms');
}
function upstreamClass(s){ if(s==='ok') return 'ok'; if(s==='unreachable'||s==='error') return 'bad'; return 'pending'; }
function captureClass(s){ if(s==='full') return 'ok'; if(s==='partial') return 'warn'; return 'pending'; }
function setHealth(d){
  var b=document.getElementById('healthBadge'); if(b){ b.textContent=d.Health; b.className='badge badge-'+healthClass(d.Health); b.title=(d.Reasons||[]).join('\n'); }
  var rb=document.getElementById('healthReasons'); if(rb){ var reasonText=rb.querySelector('.reasons-text'), icon=rb.querySelector('svg'); if(d.Reasons && d.Reasons.length){ if(reasonText) reasonText.textContent=d.Reasons.join(' · '); rb.style.display=''; } else { if(reasonText) reasonText.textContent=''; rb.style.display='none'; } if(icon) icon.style.color='var(--t2o-'+(healthClass(d.Health)==='bad'?'fail':healthClass(d.Health)==='ok'?'ok':'warn')+')'; }
  var age=document.getElementById('scrapeAge'); if(age && d.ScrapeAge){ age.textContent='as of '+d.ScrapeAge; age.classList.toggle('capture-warn',!d.Capture || d.Capture.State!=='full'); }
  // Upstream reachability is a separate signal from collector history: during a
  // transport outage the scheduler skips collector polls entirely, so the
  // collector table stays green through exactly the outage that matters.
  var u=d.Upstream; var ub=document.getElementById('upstreamBadge');
  if(ub && u){ ub.textContent='box '+u.State; ub.className='badge badge-'+upstreamClass(u.State);
    ub.title=(u.Reason||'OPNsense API health check')+' · last checked '+(u.CheckedAgo||'never'); }
  // The capture badge says whether the numbers on this page came from a clean
  // gather or a partial one. Counts and timestamps only  -  never an error string.
  var c=d.Capture; var cb=document.getElementById('captureBadge');
  if(cb && c){ cb.textContent='capture '+c.State; cb.className='badge badge-'+captureClass(c.State);
    cb.title='Passive metric capture: '+c.State+(c.ErrorCount?(' · '+c.ErrorCount+' erroring gathers, last '+(c.LastErrorAgo||'?')):''); }
  var uv=document.getElementById('ovUpstream'); if(uv && u){ uv.textContent=u.State; }
  var uvs=document.getElementById('ovUpstreamSub'); if(uvs && u){ uvs.textContent='checked '+(u.CheckedAgo||'never'); }
  var cv=document.getElementById('ovCapture'); if(cv && c){ cv.textContent=c.State; }
  var cvs=document.getElementById('ovCaptureSub'); if(cvs && c){ cvs.textContent=c.ErrorCount?(c.ErrorCount+' erroring gathers'):'no gather errors'; }
}
