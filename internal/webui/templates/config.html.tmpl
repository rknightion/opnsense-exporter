{{define "body"}}
<section class="page-head">
  <div>
    <h1>Config</h1>
    <p class="sub">Effective configuration — secret fields show presence only, never the value.</p>
  </div>
</section>

{{range .Data}}
<section class="card">
  <h2>{{.Title}}</h2>
  <table class="grid compact" data-table="config">
    <thead><tr><th>Setting</th><th>Value</th></tr></thead>
    <tbody>
    {{range .Items}}
      <tr{{if .Secret}} style="color: var(--muted)"{{end}}>
        <td>{{if .Display}}{{.Display}} <code style="color: var(--muted); font-size: 0.85em">{{.Key}}</code>{{else}}{{.Key}}{{end}}</td>
        <td>{{.Value}}</td>
      </tr>
    {{else}}
      <tr><td colspan="2" class="empty">No items.</td></tr>
    {{end}}
    </tbody>
  </table>
</section>
{{else}}
<div class="callout warn">No configuration sections available.</div>
{{end}}
{{end}}
