{{define "body"}}
{{with .Data}}
<section class="page-head">
  <div>
    <h1>Cardinality</h1>
    <p class="sub">Series volume from the last scrape snapshot — no scrape is triggered.</p>
  </div>
  <div class="head-right">
    <span class="scrape-age" data-scrape-age>as of {{.ScrapeAge}}</span>
  </div>
</section>

{{if .Empty}}
<div class="callout warn"><strong>Waiting for the first scrape.</strong> Cardinality figures appear once a scrape has been captured.</div>
{{else}}

<section class="tiles">
  <div class="tile"><span class="tile-num" data-tile="families">{{.Report.TotalFamilies}}</span><span class="tile-label">Metric families</span></div>
  <div class="tile"><span class="tile-num" data-tile="series">{{.Report.TotalSeries}}</span><span class="tile-label">Total series</span></div>
  <div class="tile"><span class="tile-num" data-tile="hot">{{.Hot}}</span><span class="tile-label">Metrics ≥ warn ({{.Report.WarnThreshold}})</span></div>
</section>

{{if .Report.Alerts}}
<div class="callout warn" data-alerts>
  <strong>High-cardinality alerts (≥ {{.Report.CritThreshold}} series)</strong>
  <ul>{{range .Report.Alerts}}<li>{{.}}</li>{{end}}</ul>
</div>
{{end}}

{{if .Report.Recommendations}}
<div class="callout warn" data-recommendations>
  <strong>Review (≥ {{.Report.WarnThreshold}} series)</strong>
  <ul>{{range .Report.Recommendations}}<li>{{.}}</li>{{end}}</ul>
</div>
{{end}}

{{if .Report.Growth}}
<section class="card">
  <h2>Series growth (per minute)</h2>
  <table class="grid compact">
    <thead><tr><th>Metric</th><th>Series</th><th>Δ / min</th></tr></thead>
    <tbody>
      {{range .Report.Growth}}
      <tr><td>{{.Name}}</td><td>{{.Series}}</td><td>{{printf "%+.2f" .PerMin}}</td></tr>
      {{end}}
    </tbody>
  </table>
</section>
{{end}}

<div class="two-col">
  <section class="card">
    <h2>Top metrics by series</h2>
    <table class="grid compact" data-table="top-metrics">
      <thead><tr><th>Metric</th><th>Series</th><th>Labels</th><th>Level</th></tr></thead>
      <tbody>
      {{range .HeadMetrics}}
        <tr data-name="{{.Name}}">
          <td><a href="/cardinality/label-values/{{.Name}}">{{.Name}}</a></td>
          <td data-value="{{.Series}}">{{.Series}}</td>
          <td>{{.Labels}}</td>
          <td><span class="badge badge-{{if eq .Level "crit"}}bad{{else if eq .Level "warn"}}warn{{else}}ok{{end}}">{{.Level}}</span></td>
        </tr>
      {{else}}
        <tr><td colspan="4" class="empty">No metrics captured.</td></tr>
      {{end}}
      </tbody>
    </table>
    <p class="sub"><a href="/cardinality/all-metrics">All metrics →</a></p>
  </section>

  <section class="card">
    <h2>Top labels by distinct values</h2>
    <table class="grid compact" data-table="top-labels">
      <thead><tr><th>Label</th><th>Distinct values</th><th>Families</th></tr></thead>
      <tbody>
      {{range .HeadLabels}}
        <tr data-name="{{.Name}}"><td>{{.Name}}</td><td data-value="{{.DistinctValues}}">{{.DistinctValues}}</td><td>{{.Families}}</td></tr>
      {{else}}
        <tr><td colspan="3" class="empty">No labels captured.</td></tr>
      {{end}}
      </tbody>
    </table>
    <p class="sub"><a href="/cardinality/all-labels">All labels →</a></p>
  </section>
</div>

<section class="card">
  <p class="sub"><a href="/cardinality/export.json">Download report (JSON)</a></p>
</section>
{{end}}
{{end}}
{{end}}
