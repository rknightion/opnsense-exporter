{{define "body"}}
{{with .Data}}
<section class="page-head">
  <div>
    <h1>Label values</h1>
    <p class="sub"><a href="/cardinality">← Cardinality</a> · <code>{{.LabelValues.Metric}}</code>{{if .LabelValues.Found}} · {{.LabelValues.Series}} series{{end}}</p>
  </div>
  <div class="head-right">
    <span class="scrape-age" data-scrape-age>as of {{.ScrapeAge}}</span>
  </div>
</section>

{{if .Empty}}
<div class="callout warn"><strong>Waiting for the first scrape.</strong> Label values appear once a scrape has been captured.</div>
{{else if not .LabelValues.Found}}
<div class="callout warn"><strong>Unknown metric.</strong> <code>{{.LabelValues.Metric}}</code> was not present in the last scrape snapshot.</div>
{{else if not .LabelValues.Labels}}
<section class="card"><p class="empty">This metric carries no labels.</p></section>
{{else}}
<section class="card">
  <div class="filter-bar">
    <input type="search" class="filter" placeholder="Filter values…" data-filter-target="label-values" aria-label="Filter label values">
  </div>
  <table class="grid compact" data-table="label-values">
    <thead><tr><th>Label</th><th>Value</th><th>Series</th></tr></thead>
    <tbody>
    {{range .LabelValues.Labels}}
      {{$label := .Name}}
      {{range .Values}}
        <tr data-name="{{$label}}" data-value="{{.Value}}">
          <td>{{$label}}</td>
          <td>{{.Value}}</td>
          <td data-sort="{{.Count}}">{{.Count}}</td>
        </tr>
      {{end}}
    {{end}}
    </tbody>
  </table>
</section>
{{end}}
{{end}}
{{end}}
