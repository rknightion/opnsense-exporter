{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-collector-degraded",
    "annotations": {
      "grafana.app/folder": "opnsense2otel-health-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense2otel-health-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseCollectorDegraded",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "10m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "info"
    },
    "annotations": {
      "summary": "OPNsense collector {{ $labels.collector }} has not fully succeeded ({{ $labels.opnsense_instance }})",
      "description": "Collector {{ $labels.collector }} is still refreshing its stored metrics, but no poll has completed CLEANLY for more than 6 of its own poll intervals ({{ $values.A.Value | printf \"%.1f\" }} missed intervals). That is the persistent-partial-failure signature: one endpoint of a multi-endpoint collector erroring every poll while the rest keep updating, so part of its metric set is silently absent or frozen while everything looks fresh. Tolerance is in MISSED INTERVALS so it scales with the collector's tier, and the rule deliberately excludes collectors already covered by OPNsenseCollectorDataStale (fully frozen data), which would otherwise fire both. Severity is info, not warning: data is still flowing, and the endpoint-error panels name the failing endpoint (#382).",
      "runbook_url": "https://github.com/rknightion/opnsense2otel/blob/main/grafana/runbooks.md#opnsensecollectordegraded",
      "__dashboardUid__": "opnsense-exporter-health",
      "__panelId__": "69"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "((time() - opnsense_exporter_collector_last_success_timestamp_seconds - 120) / opnsense_exporter_collector_poll_interval_seconds) unless on(opnsense_instance, collector) (((time() - opnsense_exporter_collector_snapshot_timestamp_seconds - 120) / opnsense_exporter_collector_poll_interval_seconds) > 3)",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  6,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
