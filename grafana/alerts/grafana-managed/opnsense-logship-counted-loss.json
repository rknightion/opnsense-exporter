{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-logship-counted-loss",
    "annotations": {
      "grafana.app/folder": "opnsense-exporter-health-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-exporter-health-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseLogShipCountedLoss",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense log-shipping counted record loss ({{ $labels.reason }}) on {{ $labels.source }} ({{ $labels.opnsense_instance }})",
      "description": "Log records were counted as lost in the last 15m, grouped by the exact source and reason. overflow means either queue bound evicted the oldest record; record_too_large was rejected at ingest; rejected was terminally refused by the destination; ship_failed_permanent exhausted the configured retry bound; and ship_failed was abandoned during shutdown. Retry attempts alone increment logs_ship_errors_total, not this alert.",
      "runbook_url": "https://github.com/rknightion/opnsense-exporter/blob/main/grafana/runbooks.md#opnsenselogshipcountedloss",
      "__dashboardUid__": "opnsense-exporter-health",
      "__panelId__": "2"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (opnsense_instance, source, reason) (increase(opnsense_exporter_logs_dropped_total[15m]))",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
