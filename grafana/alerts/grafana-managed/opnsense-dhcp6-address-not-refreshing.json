{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-dhcp6-address-not-refreshing",
    "annotations": {
      "grafana.app/folder": "opnsense2otel-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense2otel-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseDHCP6AddressNotRefreshing",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "15m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense WAN IPv6 address lease has not refreshed on {{ $labels.interface }} ({{ $labels.opnsense_instance }})",
      "description": "Nothing has created or refreshed the WAN IPv6 address lease on {{ $labels.interface }} for over two hours. The lease is still valid, so nothing has broken yet - this is the leading indicator that fires while there is still time to act, ahead of OPNsenseDHCP6AddressExpiring.",
      "runbook_url": "https://github.com/rknightion/opnsense2otel/blob/main/grafana/runbooks.md#opnsensedhcp6addressnotrefreshing",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "333"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "time() - opnsense_log_events_dhcp6c_address_updated_timestamp_seconds",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  7200,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
