{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-dhcp-client-storm",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseDHCPClientRequestStorm",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "30m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense WAN DHCP request storm on {{ $labels.interface }} ({{ $labels.opnsense_instance }})",
      "description": "dhclient has been retransmitting DHCPREQUEST far above its normal cadence for 30m. A healthy WAN renews on the order of once per lease period; a sustained retransmit rate means renewals are not being answered, and is a leading indicator of losing the address hours before it happens.",
      "runbook_url": "https://github.com/rknightion/opnsense-exporter/blob/main/grafana/runbooks.md#opnsensedhcpclientrequeststorm",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "290"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (interface, opnsense_instance) (rate(opnsense_log_events_dhcp_client_total{type=\"request\"}[15m]))",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0.1,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
