{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-ospf-lsa-retransmission-stuck",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseOSPFLSARetransmissionStuck",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "10m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense OSPF neighbor {{ $labels.neighbor_id }} not acknowledging LSAs on {{ $labels.interface }} ({{ $labels.opnsense_instance }})",
      "description": "FRR's link-state retransmission queue to neighbor {{ $labels.neighbor_id }} on {{ $labels.interface }} has stayed non-empty for 10m - FRR keeps re-flooding at least one LSA that neighbor has not acknowledged. Scoped to the ls_retransmission queue only; the db_summary/ls_request queues drain during a normal initial database sync and are not included.",
      "runbook_url": "https://github.com/rknightion/opnsense-exporter/blob/main/grafana/runbooks.md#opnsenseospflsaretransmissionstuck",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "627"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "opnsense_frr_ospf_neighbor_lsa_queue_depth{queue=\"ls_retransmission\"}",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
