{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "RecordingRule",
  "metadata": {
    "name": "oxrec-zenarmor-block-ratio5m",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "instance:opnsense_zenarmor_block:ratio5m",
    "metric": "instance:opnsense_zenarmor_block:ratio5m",
    "targetDatasourceUID": "grafanacloud-prom",
    "paused": false,
    "trigger": {
      "interval": "1m"
    },
    "labels": {},
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "10m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (opnsense_instance) (rate(opnsense_log_events_zenarmor_total{action=\"block\"}[5m])) / (sum by (opnsense_instance) (rate(opnsense_log_events_zenarmor_total[5m])) > 0)",
          "instant": false,
          "range": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "A"
        },
        "source": true
      }
    }
  }
}
