{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-netmap-ring-full",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseNetmapRingFull",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "30m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense netmap host ring full on {{ $labels.device }} ({{ $labels.opnsense_instance }})",
      "description": "The kernel has been reporting the netmap host TX ring full on {{ $labels.device }} for 30m - Zenarmor's packet-capture datapath is dropping traffic. This counts OCCURRENCES, not packets: the kernel rate-limits the underlying log line to 2 per second, so the metric saturates under sustained load and the true drop volume is unbounded above whatever this shows.",
      "runbook_url": "https://github.com/rknightion/opnsense-exporter/blob/main/grafana/runbooks.md#opnsensenetmapringfull",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "140"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (device, opnsense_instance) (rate(opnsense_log_events_netmap_ring_full_events_total[15m]))",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
