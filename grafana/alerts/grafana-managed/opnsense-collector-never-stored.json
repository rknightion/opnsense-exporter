{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-collector-never-stored",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseCollectorNeverStoredData",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "30m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense collector {{ $labels.collector }} has never returned data ({{ $labels.opnsense_instance }})",
      "description": "Collector {{ $labels.collector }} has been polling for 30m and has never once stored a metric buffer \u2014 every poll since the exporter started has failed with nothing to emit, so it exports no domain metrics at all. A clean poll that legitimately finds nothing still counts as stored, so this is a real failure, not an empty subsystem. OPNsenseCollectorDataStale cannot cover this: the snapshot-timestamp gauge is absent until the first successful store (deliberately, so it never renders as a 1970 epoch), leaving no series to measure staleness against. Usual causes are a missing plugin, an API key without permission for that endpoint, or a collector enabled against a firewall that does not run the subsystem (#382).",
      "runbook_url": "https://github.com/rknightion/opnsense-exporter/blob/main/grafana/runbooks.md#opnsensecollectorneverstoreddata"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "opnsense_exporter_collector_last_poll_timestamp_seconds unless on(opnsense_instance, collector) opnsense_exporter_collector_snapshot_timestamp_seconds",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
