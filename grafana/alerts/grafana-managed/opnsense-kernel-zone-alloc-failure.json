{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-kernel-zone-alloc-failure",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseKernelZoneAllocationFailure",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "5m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "critical"
    },
    "annotations": {
      "summary": "OPNsense kernel could not allocate {{ $labels.zone }} ({{ $labels.opnsense_instance }})",
      "description": "The FreeBSD UMA allocator has been failing to satisfy allocations in the {{ $labels.zone }} zone for 5m. This is silent, consequential loss: no new pf state means a dropped connection, no socket means a refused one, and neither produces a log line.",
      "runbook_url": "https://github.com/rknightion/opnsense-exporter/blob/main/grafana/runbooks.md#opnsensekernelzoneallocationfailure",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "93"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (zone, opnsense_instance) (rate(opnsense_kernel_memory_zone_failures_total{zone=~\"pf states|pf state keys|pf source nodes|socket|tcp_inpcb|udp_inpcb|tcpreass\"}[5m]))",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
