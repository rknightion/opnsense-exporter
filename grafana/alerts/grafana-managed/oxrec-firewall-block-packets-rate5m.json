{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "RecordingRule",
  "metadata": {
    "name": "oxrec-firewall-block-packets-rate5m",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "instance:opnsense_firewall_block_packets:rate5m",
    "metric": "instance:opnsense_firewall_block_packets:rate5m",
    "targetDatasourceUID": "",
    "paused": false,
    "trigger": {
      "interval": "1m"
    },
    "labels": {},
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "10m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (opnsense_instance, interface) (rate(opnsense_firewall_in_ipv4_block_packets[5m]) + rate(opnsense_firewall_out_ipv4_block_packets[5m]) + rate(opnsense_firewall_in_ipv6_block_packets[5m]) + rate(opnsense_firewall_out_ipv6_block_packets[5m]))",
          "instant": false,
          "range": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "A"
        },
        "source": true
      }
    }
  }
}
