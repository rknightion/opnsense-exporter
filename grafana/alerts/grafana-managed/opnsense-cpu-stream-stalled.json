{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-cpu-stream-stalled",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseCPUStreamStalled",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "5m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense CPU usage stream stalled ({{ $labels.opnsense_instance }})",
      "description": "No CPU sample has arrived from the api/diagnostics/cpu_usage SSE stream for over 2 minutes ({{ $values.A.Value | printf \"%.0f\" }}s). Frames normally arrive about once a second. The exporter's own watchdog tears down and re-dials a stalled connection, so this firing means recovery is ALSO failing - the firewall is unreachable, rebooting, or refusing the stream. cpu_seconds_total has already been withdrawn (opnsense_cpu_stream_counters_published=0), so CPU panels read absent rather than a misleading flat zero.",
      "runbook_url": "https://github.com/rknightion/opnsense2otel/blob/main/grafana/runbooks.md#opnsensecpustreamstalled",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "41"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "opnsense_cpu_stream_last_frame_age_seconds",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  120,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
