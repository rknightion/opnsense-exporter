{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-unbound-upstream-lame",
    "annotations": {
      "grafana.app/folder": "opnsense2otel-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense2otel-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseUnboundUpstreamLame",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "15m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense Unbound upstream {{ $labels.ip }} marked lame ({{ $labels.kind }}, {{ $labels.opnsense_instance }})",
      "description": "Unbound has continuously marked upstream {{ $labels.ip }} lame for its {{ $labels.kind }} queries for 15m - a full infra-cache TTL (host-ttl, default 900s). Unbound stops querying a server it has marked lame, so that server's RTT/RTO series stay perfect while resolution through it is actually failing; this is the only signal that catches it. Only emitted with --exporter.enable-unbound-infra.",
      "runbook_url": "https://github.com/rknightion/opnsense2otel/blob/main/grafana/runbooks.md#opnsenseunboundupstreamlame",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "254"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (opnsense_instance, ip, kind) (opnsense_unbound_dns_infra_host_lame)",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
