{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-gw-down-failover",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseGatewayDownFailover",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "15m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense FAILOVER gateway {{ $labels.name }} is offline ({{ $labels.opnsense_instance }})",
      "description": "Failover/secondary WAN gateway {{ $labels.name }} ({{ $labels.address }}) offline (status 0) for 15m. Lower urgency \u2014 primary WAN unaffected. The 15m window tolerates a router reboot / slow secondary-WAN re-establish.",
      "runbook_url": "https://github.com/rknightion/opnsense-exporter/blob/main/grafana/runbooks.md#opnsensegatewaydownfailover",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "196"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "opnsense_gateways_status{default_gateway=\"false\"}",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "lt",
                "params": [
                  1,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
