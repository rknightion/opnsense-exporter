{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-pf-states-near-limit",
    "annotations": {
      "grafana.app/folder": "opnsense2otel-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense2otel-alerts"
    }
  },
  "spec": {
    "title": "OPNsensePFStateTableNearLimit",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "10m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense PF state table near its limit ({{ $labels.opnsense_instance }})",
      "description": "PF state table is over 90% of its configured limit for 10m.",
      "runbook_url": "https://github.com/rknightion/opnsense2otel/blob/main/grafana/runbooks.md#opnsensepfstatetablenearlimit",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "176"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "opnsense_firewall_pf_states_current / (opnsense_firewall_pf_states_limit > 0)",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0.9,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
