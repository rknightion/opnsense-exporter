{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "RecordingRule",
  "metadata": {
    "name": "oxrec-unbound-cache-hit-ratio",
    "annotations": {
      "grafana.app/folder": "opnsense-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense-alerts"
    }
  },
  "spec": {
    "title": "instance:opnsense_unbound_cache:hit_ratio",
    "metric": "instance:opnsense_unbound_cache:hit_ratio",
    "targetDatasourceUID": "",
    "paused": false,
    "trigger": {
      "interval": "1m"
    },
    "labels": {},
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "10m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "rate(opnsense_unbound_dns_cache_hits_total[5m]) / (rate(opnsense_unbound_dns_cache_hits_total[5m]) + rate(opnsense_unbound_dns_cache_miss_total[5m]) > 0)",
          "instant": false,
          "range": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "A"
        },
        "source": true
      }
    }
  }
}
